    "scenicName": "八路军西安办事处纪念馆",
    "tag": "红色文化传播阵地——“八办”",
    "level": 4,
    "cityId": "1320620100725026817",
    "cityName": "西安",
    "address": "西安市新城区北新街七贤庄1号",
    "longitude": "108.954451",
    "latitude": "34.272696",
