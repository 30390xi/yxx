        "id": "2063892409061867521",
        "outId": "1320579064720941176",
        "type": 1,
        "advertName": "民俗之黄帝陵祭典",
        "advertPic": "https://eshopfile.zhiyousx.com/2021072618410820968.jpg",
        "jumpType": 4,
