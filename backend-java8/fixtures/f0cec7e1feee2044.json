    "scenicId": "1320579064188264540",
    "scenicName": "大唐芙蓉园",
    "tag": "进入中国盛唐文化之旅",
    "level": 5,
    "address": "西安市雁塔区曲江新区芙蓉西路99号",
    "longitude": "108.97435",
    "latitude": "34.21274",
    "openingStatus": 1,
    "capacity": 45000,
    "topColour": "#E06A2A",
    "centralColour": "#C5432E",
    "mainPictureList": [
      "https://eshopfile.zhiyousx.com/2024040611170971691.jpg",
      "https://eshopfile.zhiyousx.com/2026022810573104272.jpg",
