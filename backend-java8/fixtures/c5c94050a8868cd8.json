    "scenicName": "张骞墓景区",
    "tag": "陕西省首批重点文物保护单位",
    "level": 4,
    "cityId": "1320664075750125570",
    "cityName": "汉中",
    "address": "汉中市城固县博望街道办事处饶家营村",
    "longitude": "107.296096",
    "latitude": "33.155827",
    "openingStatus": 1,
