    "bannerList": [
      {
        "id": "1518161961014046722",
        "outId": "1320579064595111940",
        "type": 1,
        "advertName": "为中华之崛起而读书",
        "advertPic": "https://eshopfile.zhiyousx.com/2021062418190521586.jpg",
