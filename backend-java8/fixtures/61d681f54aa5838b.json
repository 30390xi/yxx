    "scenicId": "1320579064708358148",
    "scenicName": "八路军西安办事处纪念馆",
    "tag": "红色文化传播阵地——“八办”",
    "level": 4,
    "address": "西安市新城区北新街七贤庄1号",
    "longitude": "108.954451",
    "latitude": "34.272696",
