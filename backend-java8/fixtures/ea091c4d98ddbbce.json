    "noticeMsg": "<section></section>\n<section class=\"_135editor\" style=\"-webkit-tap-highlight-color: transparent; margin-bottom: 0px; outline: 0px; font-size: 16px; letter-spacing: 0.544px; background-color: #ffffff; visibility: visible; font-family: 'PingFang SC', system-ui, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Hiragino Sans GB', 'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; color: #222222; letter-spacing: 0.544px; visibility: visible; text-align: left; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif;\">\n<section class=\"_135editor\" style=\"-webkit-tap-highlight-color: transparent; margin-top: 10px; margin-bottom: 10px; outline: 0px; visibility: visible;\">\n<section style=\"-webkit-tap-highlight-color: transparent; padding: 3px; outline: 0px; visibility: visible; box-sizing: border-box; border: 1px solid #ec0d0d;\">\n<section class=\"_135editor\" style=\"-webkit-tap-highlight-color: transparent; outline: 0px; visibility: visible;\">\n<section class=\"\" style=\"-webkit-tap-highlight-color: transparent; padding: 10px; outline: 0px; visibility: visible; box-sizing: border-box; border: 3px solid #ec0d0d;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; visibility: visible;\">\n<section class=\"_135editor\" style=\"-webkit-tap-highlight-color: transparent; margin-top: 10px; margin-bottom: 10px; outline: 0px; visibility: visible;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; visibility: visible;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; line-height: 0; text-align: center; visibility: visible;\">\n<section class=\"\" style=\"-webkit-tap-highlight-color: transparent; outline: 0px; visibility: visible;\"></section>\n<section class=\"\" style=\"-webkit-tap-highlight-color: transparent; outline: 0px; vertical-align: middle; display: inline-block; line-height: 0; visibility: visible; width: 540px; box-sizing: border-box;\">\n<p>&nbsp;</p>\n</section>\n</section>\n</section>\n</section>\n<section class=\"_135editor\" style=\"-webkit-tap-highlight-color: transparent; outline: 0px; visibility: visible;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; text-align: center; visibility: visible;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; visibility: visible;\">\n<section class=\"_135editor\" style=\"-webkit-tap-highlight-color: transparent; outline: 0px; visibility: visible;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; clear: both; min-height: 1em; visibility: visible;\">\n<p style=\"-webkit-tap-highlight-color: transparent; outline: 0px; visibility: visible;\">&nbsp;</p>\n</section>\n</section>\n<section class=\"_135editor\" style=\"-webkit-tap-highlight-color: transparent; outline: 0px; display: contents;\" data-filtered=\"filtered\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; display: contents;\" data-filtered=\"filtered\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; display: contents;\" data-filtered=\"filtered\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; text-align: right; text-indent: 0em; visibility: visible;\"></section>\n</section>\n</section>\n</section>\n<section class=\"_135editor\" style=\"-webkit-tap-highlight-color: transparent; outline: 0px; display: contents;\" data-filtered=\"filtered\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; display: contents;\" data-filtered=\"filtered\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; display: contents;\" data-filtered=\"filtered\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; text-align: right;\">\n<section style=\"max-width: 100%; box-sizing: border-box; visibility: visible;\" data-pm-slice=\"0 0 []\">\n<section style=\"max-width: 100%; box-sizing: border-box; visibility: visible; font-family: PingFangSC-light;\">\n<p style=\"margin: 0px; padding: 0px; box-sizing: border-box; visibility: visible; text-align: center;\" align=\"center\"><strong style=\"letter-spacing: 0.034em; box-sizing: border-box; visibility: visible;\"><span style=\"font-size: 18px; box-sizing: border-box; visibility: visible;\">华山景区冬季惠民政策公告</span></strong></p>\n</section>\n</section>\n<section style=\"text-align: justify; box-sizing: border-box; visibility: visible;\">\n<p style=\"white-space: normal; margin: 0px; padding: 0px; box-sizing: border-box; visibility: visible;\">&nbsp;</p>\n</section>\n<section style=\"display: contents; box-sizing: border-box;\">\n<section style=\"display: contents; box-sizing: border-box;\">\n<section style=\"display: contents; box-sizing: border-box;\">\n<section style=\"text-align: right; text-indent: 0em; box-sizing: border-box; visibility: visible;\"></section>\n</section>\n</section>\n</section>\n<section style=\"max-width: 100%; box-sizing: border-box; visibility: visible;\">\n<section style=\"text-align: justify; letter-spacing: 2px; line-height: 2; max-width: 100%; box-sizing: border-box; visibility: visible; font-family: PingFangSC-light;\">\n<section style=\"max-width: 100%; box-sizing: border-box; font-size: 15px; letter-spacing: 1.8px; visibility: visible; font-family: PingFangSC-light;\">\n<p style=\"text-indent: 0em; white-space: normal; margin: 0px; padding: 0px; box-sizing: border-box; visibility: visible;\">游客朋友们：</p>\n<p style=\"text-indent: 2em;\">为回馈广大游客对华山景区的喜爱与支持，景区推出冬季专项惠民政策，具体公告如下：</p>\n<p style=\"text-indent: 2em;\"><strong>一、政策执行时间</strong></p>\n<p style=\"text-indent: 2em;\">2026年1月1日&mdash;2026年2月28日（含国家法定节假日）</p>\n<p style=\"text-indent: 2em;\"><strong>二、每日游客限流</strong></p>\n<p style=\"text-indent: 2em;\">因冬季气候特点和景区实际，华山景区每日最大接待人数限量20000人次。</p>\n<p style=\"text-indent: 2em;\"><strong>三、惠民政策内容</strong></p>\n<p style=\"text-indent: 2em;\">1. 景区门票：成人门票在冬季门票价格基础上实行八折优惠。</p>\n<p style=\"text-indent: 2em;\">2. 索道票：成人索道票执行九折优惠（含北峰、西峰索道）。</p>\n<p style=\"text-indent: 2em;\">3. 西岳庙景区：免费开放（无需购票，凭有效身份证件入园）。</p>\n<p style=\"text-indent: 2em;\">4. 老人，儿童，学生，军人等符合优惠政策的群体，优惠按原有政策执行（本次惠民政策不与其他优惠政策叠加使用）。</p>\n<p style=\"text-indent: 2em;\"><strong>四、购票与入园须知</strong></p>\n<p style=\"text-indent: 2em;\">1. 优惠门票实行实名制预约购买，游客可通过华山景区官方微信公众号等正规渠道提前预约，售完即止。</p>\n<p style=\"text-indent: 2em;\">2. 购票时需准确填写本人有效身份证件信息，入园时须凭购票时使用的证件原件核验入园。</p>\n<p style=\"text-indent: 2em;\"><strong>五、温馨提示</strong></p>\n<p style=\"text-indent: 2em;\">1. 冬季华山气温较低，部分路段可能出现积雪结冰，建议游客提前关注天气及景区运营信息，备好防滑鞋、保暖衣物等防护用品。</p>\n<p style=\"text-indent: 2em;\">2. 景区严格落实&ldquo;限量、预约、错峰&rdquo;要求，为保障游览安全与体验，建议合理规划行程，避开高峰时段。</p>\n<p style=\"text-indent: 2em;\">3. 请通过官方渠道购票，谨防虚假信息和购票陷阱，维护自身合法权益。</p>\n<p style=\"text-indent: 2em;\">4. 景区咨询电话：0913-8376888、0913-8375999</p>\n<p style=\"text-indent: 2em;\">&nbsp;</p>\n<p style=\"text-indent: 2em;\">诚邀广大游客相约冬日华山，赏雾凇奇景，感雄峰壮阔，共赴一场难忘的冬日之旅！</p>\n<p style=\"white-space: normal; margin: 0px; padding: 0px; box-sizing: border-box; text-align: right;\" align=\"right\">来源：华山景区&nbsp; &nbsp;&nbsp;</p>\n</section>\n</section>\n</section>\n<p style=\"-webkit-tap-highlight-color: transparent; outline: 0px; text-align: justify;\" align=\"justify\">&nbsp;</p>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n<section class=\"_135editor\" style=\"-webkit-tap-highlight-color: transparent; margin-bottom: 0px; outline: 0px; font-size: 16px; letter-spacing: 0.544px; background-color: #ffffff; font-family: 'PingFang SC', system-ui, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Hiragino Sans GB', 'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; color: #222222; font-size: 17px; letter-spacing: 0.544px; visibility: visible; text-align: left; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; text-align: center; color: #353535; font-size: medium; letter-spacing: 0.544px; visibility: visible; font-family: -apple-system-font, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; letter-spacing: 0.544px; background-color: #feffff; color: #ffffff; font-size: 16px; caret-color: #333333; visibility: visible; font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; color: #222222; letter-spacing: 0.544px; visibility: visible; font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: none 0px; color: #000000; font-size: 14px; letter-spacing: 2px; min-height: 1em; cursor: text; line-height: 2em; font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; background-color: #ffffff; letter-spacing: 0.578px; color: #909090; line-height: 3em; visibility: visible; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif;\">\n<p style=\"-webkit-tap-highlight-color: transparent; outline: 0px; font-size: 12px; letter-spacing: 0.578px;\">&nbsp;</p>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n<section style=\"-webkit-tap-highlight-color: transparent; margin-bottom: 0px; outline: 0px; color: #3e3e3e; letter-spacing: 1.8px; text-align: center; background-color: #ffffff;\">\n<section style=\"-webkit-tap-highlight-color: transparent; outline: 0px; font-size: 16px; color: rgba(160, 160, 160, 0.82); letter-spacing: 1.6px; line-height: normal;\">\n<p>&nbsp;</p>\n</section>\n</section>\n<p>&nbsp;</p>\n<p style=\"display: none;\">&nbsp;</p>\n<section class=\"_135editor\"></section>\n<p>&nbsp;</p>",
