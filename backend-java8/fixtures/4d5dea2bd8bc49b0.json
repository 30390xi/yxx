    "scenicName": "柞水溶洞地质公园",
    "tag": "自然环境灵秀典雅，景点多而集中",
    "level": -1,
    "address": "商洛市柞水县南石瓮镇",
    "longitude": "109.1729000000",
    "latitude": "33.5723430000",
    "openingStatus": 1,
    "capacity": 9999,
    "topColour": "#626EEF",
