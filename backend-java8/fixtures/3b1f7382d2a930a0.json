      {
        "id": "2030838600832253953",
        "outId": "1409840200741392386",
        "type": 1,
        "advertName": "探寻宝鸡红色记忆",
        "advertPic": "https://eshopfile.zhiyousx.com/2021062919561213121.jpg",
        "jumpType": 4,
        "jumpUrl": "",
