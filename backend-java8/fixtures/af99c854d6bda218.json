      {
        "id": "1418415191049138177",
        "outId": "1320579064590917643",
        "type": 1,
        "advertName": "吹响黄河岸边的胜利号角",
        "advertPic": "https://eshopfile.zhiyousx.com/2021062918203589396.jpg",
