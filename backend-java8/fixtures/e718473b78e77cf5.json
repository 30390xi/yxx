    "noticeMsg": "<section data-mpa-powered-by=\"yiban.io\">\n<section class=\"\">\n<section class=\"\"></section>\n<section style=\"box-sizing: border-box; font-style: normal; font-weight: 400; text-align: justify; font-size: 16px; color: #3e3e3e;\" data-pm-slice=\"0 0 []\">\n<section class=\"\" style=\"text-align: center; justify-content: center; display: flex; flex-flow: row; margin: 10px 0px; box-sizing: border-box;\">\n<section style=\"display: inline-block; width: auto; vertical-align: top; align-self: flex-start; flex: 0 0 auto; min-width: 5%; max-width: 100%; height: auto; box-sizing: border-box;\">\n<section style=\"justify-content: center; display: flex; flex-flow: row; margin: -1px 0px 3px; box-sizing: border-box;\">\n<section class=\"\" style=\"display: inline-block; width: 23px; vertical-align: top; align-self: flex-start; flex: 0 0 auto; background-color: #ffffff; height: auto; box-sizing: border-box;\">\n<section style=\";box-sizing: border-box; transform: rotateZ(328deg); -webkit-transform: rotateZ(328deg); -moz-transform: rotateZ(328deg); -o-transform: rotateZ(328deg);\">\n<section style=\"margin: 7px 0px 0px; text-align: right; box-sizing: border-box; transform: translate3d(2px, 0px, 0px); -webkit-transform: translate3d(2px, 0px, 0px); -moz-transform: translate3d(2px, 0px, 0px); -o-transform: translate3d(2px, 0px, 0px);\">\n<section style=\"background-color: #d2aa6f; height: 1px; box-sizing: border-box;\"></section>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n</section>\n<section style=\"box-sizing: border-box; font-style: normal; font-weight: 400; text-align: justify; font-size: 16px; color: #3e3e3e;\" data-pm-slice=\"0 0 []\">\n<section style=\"margin: 10px 0px; box-sizing: border-box;\">\n<section class=\"\" style=\"width: 100%; padding: 15px 10px 25px; border-radius: 1em; margin-bottom: -30px; background-color: #fff8f5; max-width: 100% !important; box-sizing: border-box;\">\n<section class=\"\" style=\"color: #2a2522; line-height: 1.75; letter-spacing: 2px; box-sizing: border-box;\">\n<p style=\"text-indent: 2.25em; white-space: normal; margin: 0px; padding: 0px; box-sizing: border-box;\"><span style=\"text-indent: 2.25em; box-sizing: border-box;\">2025年国庆、中秋双节将至，现将西安市钟鼓楼博物馆双节期间开放时间安排如下：</span></p>\n<p style=\"text-indent: 2.25em; white-space: normal; margin: 0px; padding: 0px; box-sizing: border-box;\">&nbsp;</p>\n<p style=\"text-indent: 2.25em; white-space: normal; margin: 0px; padding: 0px; box-sizing: border-box;\">我馆每日开放时间为8：30&mdash;21：30（20：00停售套票，21：00停止售票）。</p>\n</section>\n</section>\n<section style=\"height: 30px; border-bottom-width: 5px; border-bottom-style: solid; display: inline-block; vertical-align: top; border-radius: 1em; box-sizing: border-box;\"></section>\n</section>\n</section>\n<p style=\"text-align: right;\" align=\"right\">来源：西安市钟鼓楼博物馆</p>\n</section>\n</section>",
