<view class="reservation-detail data-v-3a0f68dd">
    <uni-navbar bind:__l="__l" class="data-v-3a0f68dd" scrollTop="{{scrollTop}}" title="预约详情" titleCenter="{{false}}" type="transparentFixed" vueId="2b54f9fa-1"></uni-navbar>
    <view class="unreal-header data-v-3a0f68dd" style="{{'opacity:'+opacity+';'+'padding:'+statusBarHeight+'px 96rpx 24rpx 24rpx'+';'}}">
        <view class="unreal-header-content data-v-3a0f68dd"></view>
    </view>
    <view class="header-bg data-v-3a0f68dd">
        <view class="card data-v-3a0f68dd"></view>
    </view>
    <view class="reservation-detail-body data-v-3a0f68dd">
        <view class="status-view data-v-3a0f68dd">{{tabList[detailInfo.status]}}</view>
        <view class="detail-card data-v-3a0f68dd" wx:if="{{!isError}}">
            <scenic-spot bind:__l="__l" class="data-v-3a0f68dd" info="{{detailInfo}}" vueId="2b54f9fa-2"></scenic-spot>
            <view class="divider data-v-3a0f68dd" wx:if="{{detailInfo.status===1}}"></view>
            <scenic-sport-code bind:__l="__l" class="data-v-3a0f68dd" info="{{detailInfo}}" vueId="2b54f9fa-3" wx:if="{{detailInfo.status===1}}"></scenic-sport-code>
        </view>
        <view class="detail-card data-v-3a0f68dd">
            <view class="data-v-3a0f68dd" data-title="使用说明">{{detailInfo.keyNotes||'--'}}</view>
            <view class="divider data-v-3a0f68dd"></view>
            <view class="data-v-3a0f68dd" data-title="退改说明">{{detailInfo.refundNotes||'--'}}</view>
        </view>
        <view class="detail-card data-v-3a0f68dd">
            <view class="reservation data-v-3a0f68dd" data-title="预约信息">
                <view class="data-v-3a0f68dd" data-label="预约编号">{{''+(detailInfo.orderSn||'--')+''}}<view bindtap="__e" class="copy-btn data-v-3a0f68dd" data-event-opts="{{[ [ 'tap',[ [ 'copy',['$event'] ] ] ] ]}}">复制</view>
                </view>
                <view class="data-v-3a0f68dd" data-label="下单时间">{{''+(detailInfo.createOrderTime||'--')+''}}</view>
                <view class="data-v-3a0f68dd" data-label="持卡信息">{{''+(detailInfo.title||'--')+''}}</view>
            </view>
        </view>
        <view class="footer data-v-3a0f68dd" wx:if="{{detailInfo.status===1}}">
            <view bindtap="__e" class="btn data-v-3a0f68dd" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}">取消预约</view>
        </view>
        <u-modal bind:__l="__l" bind:confirm="__e" bind:input="__e" class="data-v-3a0f68dd" content="是否取消预约?" data-event-opts="{{[ [ '^confirm',[ ['cancelReservation'] ] ],[ '^input',[ [ '__set_model',[ '','show','$event',[] ] ] ] ] ]}}" maskCloseAble="{{true}}" showCancelButton="{{true}}" value="{{show}}" vueId="2b54f9fa-4"></u-modal>
    </view>
</view>
