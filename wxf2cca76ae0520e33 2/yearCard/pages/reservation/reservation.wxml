<view class="box data-v-7d29c2b4" wx:if="{{detailObj.yearCardId}}">
    <view class="navbar data-v-7d29c2b4" style="{{'height:'+searchHeight+38+'px'+';'+'background:'+'rgba(255,255,255,'+navBarBg+')'+';'+'padding-top:'+searchHeight+'px'+';'}}">
        <uni-icons bind:__l="__l" bind:click="__e" class="data-v-7d29c2b4" color="{{fontColor}}" data-event-opts="{{[ [ '^click',[ ['back'] ] ] ]}}" size="20" type="arrowleft" vueId="d9ed3bc8-1"></uni-icons>
        <view class="navName data-v-7d29c2b4" style="{{'color:'+fontColor+';'}}">预约</view>
    </view>
    <view class="topBj data-v-7d29c2b4"></view>
    <view class="card-box data-v-7d29c2b4" style="{{'padding-top:'+searchHeight+38+'px'+';'}}">
        <view class="card-item data-v-7d29c2b4">
            <image class="card-img data-v-7d29c2b4" mode="aspectFill" src="{{detailObj.image}}"></image>
            <view class="card-content data-v-7d29c2b4">
                <view class="title data-v-7d29c2b4">{{detailObj.title}}</view>
                <view class="name data-v-7d29c2b4">{{'持卡人：'+detailObj.cardholderName}}</view>
                <view class="name time data-v-7d29c2b4">{{'有效期至：'+$root.m0}}</view>
            </view>
        </view>
    </view>
    <view class="successTip model data-v-7d29c2b4" wx:if="{{successShow}}">
        <view class="success-icon data-v-7d29c2b4">
            <image class="data-v-7d29c2b4" mode="aspectFill" src="https://eshopfile.zhiyousx.com/170073354191260146.png"></image>
        </view>
        <view class="text data-v-7d29c2b4">提交成功, 系统处理中...</view>
        <view class="remark data-v-7d29c2b4">系统将在30分钟内返回处理结果，若预约失败，将自动为您取消订单，请前往预约详情页查看预约结果</view>
    </view>
    <view class="success-btn data-v-7d29c2b4" wx:if="{{successShow}}">
        <view bindtap="__e" class="btn data-v-7d29c2b4" data-event-opts="{{[ [ 'tap',[ [ 'goPage',[0] ] ] ] ]}}">返回首页</view>
        <view bindtap="__e" class="btn getOrder data-v-7d29c2b4" data-event-opts="{{[ [ 'tap',[ [ 'goPage',[1] ] ] ] ]}}">查看订单</view>
    </view>
    <view class="ticket-box model data-v-7d29c2b4" wx:if="{{!successShow}}">
        <view class="ticket data-v-7d29c2b4">
            <view class="img data-v-7d29c2b4">
                <image class="title-img data-v-7d29c2b4" mode="aspectFill" src="{{yearCardTicket.ticketImage}}"></image>
                <view class="allTimes data-v-7d29c2b4">
                    <label class="_span data-v-7d29c2b4" wx:if="{{yearCardTicket.useTimesLimit}}">{{'免'+yearCardTicket.totalTimes+'次'}}</label>
                    <label class="_span data-v-7d29c2b4" wx:else>无限次</label>
                </view>
            </view>
            <view class="info data-v-7d29c2b4">
                <view class="name multilineText2 data-v-7d29c2b4">{{yearCardTicket.scenicName}}</view>
                <view class="lable data-v-7d29c2b4">
                    <view class="p1 _p data-v-7d29c2b4">
                        <label class="_span data-v-7d29c2b4" wx:if="{{yearCardTicket.useTimesLimit}}">{{'剩余'+yearCardTicket.usableTimes+'次'}}</label>
                        <label class="_span data-v-7d29c2b4" wx:else>无限次</label>
                    </view>
                    <view class="p2 _p data-v-7d29c2b4">{{'已约'+yearCardTicket.appointmentNum-yearCardTicket.refundNum+'次'}}</view>
                </view>
            </view>
        </view>
        <view class="way data-v-7d29c2b4" wx:if="{{yearCardTicket.keyNotes}}">
            <view class="title _p data-v-7d29c2b4">使用方式</view>
            <view class="remark data-v-7d29c2b4">{{yearCardTicket.keyNotes}}</view>
        </view>
    </view>
    <view class="date model data-v-7d29c2b4" wx:if="{{!successShow}}">
        <view class="data-v-7d29c2b4" wx:if="{{yearCardTicket.dateType==2}}">
            <view class="title _p data-v-7d29c2b4">预约日期</view>
            <view class="date-box data-v-7d29c2b4">
                <view class="scroll-box-date data-v-7d29c2b4" wx:if="{{$root.g0>0}}">
                    <scroll-view class="left data-v-7d29c2b4" scrollIntoView="{{scrollToDate}}" scrollX="{{true}}">
                        <view bindtap="__e" class="{{['date-item','data-v-7d29c2b4',activeDate==index?'activeDate':'',item.disabled?'disable':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'selectedDate',['$0',index],[ [ ['dateList','',index] ] ] ] ] ] ]}}" id="{{'date-'+item.date}}" wx:for="{{dateList}}" wx:key="index">
                            <view class="selected data-v-7d29c2b4">
                                <uni-icons bind:__l="__l" class="icon data-v-7d29c2b4" color="#fff" size="12" type="checkmarkempty" vueId="{{'d9ed3bc8-2-'+index}}"></uni-icons>
                            </view>
                            <view class="date-str data-v-7d29c2b4">{{''+item.dateShort+' '+item.week+''}}</view>
                            <view class="price data-v-7d29c2b4">{{''+item.diy+''}}</view>
                        </view>
                    </scroll-view>
                    <view class="line data-v-7d29c2b4"></view>
                    <view bindtap="__e" class="right data-v-7d29c2b4" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}">
                        <view class="text data-v-7d29c2b4">更多日期</view>
                        <image mode class="arrow data-v-7d29c2b4" src="https://eshopfile.zhiyousx.com/169821946405933051.png"></image>
                    </view>
                </view>
            </view>
            <view class="selectTime data-v-7d29c2b4" wx:if="{{$root.g1}}">
                <view bindtap="__e" class="{{['time-item','data-v-7d29c2b4',activeTime===index?'active':'',item.surplusStock==0||item.disabled?'disable':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'selectTime',['$0',index],[ [ ['selectStockVos','',index] ] ] ] ] ] ]}}" wx:for="{{selectStockVos}}" wx:key="index">
                    <view class="time _p data-v-7d29c2b4">{{item.time}}</view>
                    <view class="desc _p data-v-7d29c2b4" wx:if="{{!item.disabled}}">{{item.surplusStock>0?'可约':'已约满'}}</view>
                    <view class="selected data-v-7d29c2b4">
                        <uni-icons bind:__l="__l" class="icon data-v-7d29c2b4" color="#fff" size="12" type="checkmarkempty" vueId="{{'d9ed3bc8-3-'+index}}"></uni-icons>
                    </view>
                </view>
            </view>
        </view>
        <view class="effective data-v-7d29c2b4" wx:else>
            <view class="title _p data-v-7d29c2b4">有效日期</view>
            <view class="time _p data-v-7d29c2b4">{{yearCardTicket.datePeriodBegin+'至'+yearCardTicket.datePeriodEnd}}</view>
            <view class="lose _p data-v-7d29c2b4" wx:if="{{$root.m1}}">{{$root.m2}}</view>
            <view class="lose _p data-v-7d29c2b4" wx:if="{{yearCardTicket.dateCannotUse}}">{{$root.m3+'不可用'}}</view>
        </view>
        <view class="people data-v-7d29c2b4">
            <view class="title data-v-7d29c2b4">
                <view class="left data-v-7d29c2b4">预约人</view>
                <view class="tip data-v-7d29c2b4">仅限持卡人本人使用</view>
            </view>
            <view class="people-item data-v-7d29c2b4">
                <view class="label data-v-7d29c2b4">持卡人</view>
                <view class="value data-v-7d29c2b4">{{name}}</view>
                <image bindtap="__e" class="icon data-v-7d29c2b4" data-event-opts="{{[ [ 'tap',[ [ 'getPhone',[1] ] ] ] ]}}" src="https://eshopfile.zhiyousx.com/168492134271144514.png" wx:if="{{!isEncryption}}"></image>
                <image bindtap="__e" class="icon data-v-7d29c2b4" data-event-opts="{{[ [ 'tap',[ [ 'getPhone',[0] ] ] ] ]}}" src="https://eshopfile.zhiyousx.com/168492259404793104.png" wx:if="{{isEncryption}}"></image>
            </view>
            <view class="people-item data-v-7d29c2b4" wx:if="{{cardNum}}">
                <view class="label data-v-7d29c2b4">身份证</view>
                <view class="value data-v-7d29c2b4">{{cardNum}}</view>
            </view>
            <view class="people-item data-v-7d29c2b4">
                <view class="label data-v-7d29c2b4">手机号</view>
                <view class="value data-v-7d29c2b4">{{phoneNum}}</view>
            </view>
        </view>
    </view>
    <view class="line_submit data-v-7d29c2b4" style="{{'height:'+100+safeAreaBottom+'rpx'+';'+'padding-bottom:'+safeAreaBottom+'rpx'+';'}}" wx:if="{{!successShow}}">
        <view bindtap="__e" class="submit_btn data-v-7d29c2b4" data-event-opts="{{[ [ 'tap',[ ['submit'] ] ] ]}}">提交预约</view>
    </view>
    <u-popup bind:__l="__l" bind:input="__e" borderRadius="20" class="data-v-7d29c2b4" closeable="{{true}}" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '','showSelectDate','$event',[] ] ] ] ] ]}}" mode="center" value="{{showSelectDate}}" vueId="d9ed3bc8-4" vueSlots="{{['default']}}">
        <view class="selectDateBox data-v-7d29c2b4">
            <view class="title data-v-7d29c2b4">选择团期</view>
            <scroll-view class="content data-v-7d29c2b4" scrollY="{{true}}" wx:if="{{$root.g2>0}}">
                <yu-calendar bind:__l="__l" bind:getDataInDay="__e" class="data-v-7d29c2b4" data-event-opts="{{[ [ '^getDataInDay',[ ['itemClickFn'] ] ] ]}}" defaultDate="{{selectDateStr}}" priceList="{{dateList}}" vueId="{{'d9ed3bc8-5'+','+'d9ed3bc8-4'}}"></yu-calendar>
                <view class="selectTime data-v-7d29c2b4" wx:if="{{$root.g3}}">
                    <view bindtap="__e" class="{{['time-item','data-v-7d29c2b4',activeTime===index?'active':'',item.surplusStock==0||item.disabled?'disable':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'selectTime',['$0',index],[ [ ['selectStockVos','',index] ] ] ] ] ] ]}}" wx:for="{{selectStockVos}}" wx:key="index">
                        <view class="time _p data-v-7d29c2b4">{{item.time}}</view>
                        <view class="desc _p data-v-7d29c2b4" wx:if="{{!item.disabled}}">{{item.surplusStock>0?'可约':'已约满'}}</view>
                        <view class="selected data-v-7d29c2b4">
                            <uni-icons bind:__l="__l" class="icon data-v-7d29c2b4" color="#fff" size="12" type="checkmarkempty" vueId="{{'d9ed3bc8-6-'+index+','+'d9ed3bc8-4'}}"></uni-icons>
                        </view>
                    </view>
                </view>
            </scroll-view>
        </view>
    </u-popup>
    <u-popup bind:__l="__l" bind:input="__e" borderRadius="20" class="data-v-7d29c2b4" closeable="{{true}}" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '','showErr','$event',[] ] ] ] ] ]}}" mode="center" value="{{showErr}}" vueId="d9ed3bc8-7" vueSlots="{{['default']}}">
        <view class="errBox data-v-7d29c2b4">
            <view class="title data-v-7d29c2b4">提示</view>
            <view class="content data-v-7d29c2b4">{{''+errMsg+''}}</view>
            <view bindtap="__e" class="btn data-v-7d29c2b4" data-event-opts="{{[ [ 'tap',[ [ 'e1',['$event'] ] ] ] ]}}">我知道了</view>
        </view>
    </u-popup>
</view>
