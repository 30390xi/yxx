.swiperPanel{height:360rpx;margin:20rpx 0;overflow:hidden;position:relative;width:100%}.swiperPanel .swiperItem{height:340rpx;left:0;position:absolute;top:0;transition:all .5s;width:100%}.swiperPanel .swiperItem .content{border-radius:20rpx;box-shadow:0 20rpx 0 hsla(0,12%,92%,.7);display:-webkit-flex;display:flex;flex-direction:column;height:100%;margin:2rpx auto;padding:50rpx 40rpx;width:540rpx}.swiperPanel .swiperItem .content .card-title{color:#fff;font-size:36rpx;font-weight:700;line-height:42rpx;margin-bottom:30rpx}.swiperPanel .swiperItem .content .card-num{align-items:center;color:#fff;display:-webkit-flex;display:flex;font-size:26rpx;font-weight:400;line-height:30rpx}.swiperPanel .swiperItem .content .card-num text{color:#fff;font-size:26rpx;font-weight:700;line-height:30rpx}.swiperPanel .swiperItem .content .card-body-time{color:#fff;font-size:26rpx;font-weight:400;line-height:40rpx;margin-top:auto}