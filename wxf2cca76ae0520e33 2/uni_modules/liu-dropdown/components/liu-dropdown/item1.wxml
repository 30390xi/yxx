<view class="item-main data-v-4d34c4ac" style="{{height?'height:'+height+'rpx;':''}}">
    <view class="item-list data-v-4d34c4ac">
        <scroll-view class="item-left data-v-4d34c4ac" scrollY="true">
            <view catchtap="__e" class="item-left-list data-v-4d34c4ac" data-event-opts="{{[ [ 'tap',[ [ 'selectLeft',[index] ] ] ] ]}}" style="{{selectLeftIndex==index?'color:'+themeColor+';background: #FFFFFF;border-radius:0rpx;':''}}" wx:for="{{newList}}" wx:key="index">{{item.name+''}}</view>
        </scroll-view>
        <scroll-view class="item-right data-v-4d34c4ac" scrollY="true">
            <view class="data-v-4d34c4ac" wx:if="{{$root.g0}}">
                <view catchtap="__e" class="item-right-list data-v-4d34c4ac" data-event-opts="{{[ [ 'tap',[ [ 'selectRight',['$0'],[ [ ['newList.'+selectLeftIndex+'.childs','',inx] ] ] ] ] ] ]}}" wx:for="{{newList[selectLeftIndex].childs}}" wx:for-index="inx" wx:for-item="mess" wx:key="inx">
                    <view class="item-right-list-name data-v-4d34c4ac" style="{{mess.chooseState?'color:'+themeColor:''}}">{{''+mess.name+''}}</view>
                    <image class="item-right-list-img data-v-4d34c4ac" src="../../static/select.png" wx:if="{{mess.chooseState}}"></image>
                </view>
            </view>
            <view class="no-data data-v-4d34c4ac" wx:else>暂无数据</view>
        </scroll-view>
    </view>
    <view class="btn-list data-v-4d34c4ac">
        <view catchtap="__e" class="btn-reset data-v-4d34c4ac" data-event-opts="{{[ [ 'tap',[ [ 'reset',['$event'] ] ] ] ]}}">重置</view>
        <view catchtap="__e" class="btn-complete data-v-4d34c4ac" data-event-opts="{{[ [ 'tap',[ [ 'complete',['$event'] ] ] ] ]}}" style="{{'background: '+themeColor}}">完成</view>
    </view>
</view>
