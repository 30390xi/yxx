<view catchtouchmove="__e" data-event-opts="{{[ [ 'touchmove',[ [ '',['$event'] ] ] ] ]}}">
    <view class="{{['tui-popup-class','tui-bottom-popup',show?'tui-popup-show':'']}}" style="{{'background:'+bgcolor+';'}}">
        <slot></slot>
    </view>
    <view bindtap="__e" class="{{['tui-popup-mask',show?'tui-mask-show':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'handleClose',['$event'] ] ] ] ]}}" wx:if="{{mask}}"></view>
</view>
