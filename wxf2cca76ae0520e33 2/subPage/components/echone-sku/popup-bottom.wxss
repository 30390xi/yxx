.tui-bottom-popup{bottom:0;left:0;min-height:20rpx;position:fixed;right:0;transform:translate3d(0,100%,0);transform-origin:center;transition:all .3s ease-in-out;visibility:hidden;width:100%;z-index:99}.tui-popup-show{transform:translateZ(0);visibility:visible}.tui-popup-mask{background:rgba(0,0,0,.3);bottom:0;left:0;opacity:0;position:fixed;right:0;top:0;transition:all .3s ease-in-out;visibility:hidden;z-index:89}.tui-mask-show{opacity:1;visibility:visible}