                        </view>
                    </view>
                </view>
            </view>
            <view class="{{['data-v-679ff233',item.$orig.isShow?'coupon-show':'coupon-hide']}}">
                <view class="con-msg data-v-679ff233" style="border-top:1rpx dashed #FFD3C6;">{{''+item.$orig.useExplain+''}}</view>
            </view>
        </view>
