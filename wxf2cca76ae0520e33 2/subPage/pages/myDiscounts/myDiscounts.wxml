<view class="page data-v-679ff233">
    <view class="top-bar data-v-679ff233" id="menu">
        <block wx:for="{{menuList}}">
            <view bindtap="__e" class="{{['menu-item','data-v-679ff233',index+1==menuId?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'menuTap',['$0',index],[ [ ['menuList','',index,'id'] ] ] ] ] ] ]}}" wx:if="{{menuId<3}}">
                <text class="menuTit data-v-679ff233">{{item.name}}</text>
            </view>
            <view bindtap="__e" class="{{['menu-item','data-v-679ff233',index+1==menuId?'active1':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'menuTap',['$0',index],[ [ ['menuList','',index,'id'] ] ] ] ] ] ]}}" wx:else>
                <text class="menuTit data-v-679ff233">{{item.name}}</text>
            </view>
        </block>
    </view>
    <view class="coupon-box data-v-679ff233" hidden="{{!!showNull}}">
        <view class="coupon-item data-v-679ff233" wx:if="{{orderStatus==1}}" wx:for="{{$root.l0}}" wx:key="index">
            <view class="line data-v-679ff233" wx:if="{{item.$orig.itemType==1}}">门票</view>
            <view class="ticket data-v-679ff233" wx:if="{{item.$orig.itemType==2}}">线路</view>
            <view class="coupon data-v-679ff233">
                <view class="cou-l-l data-v-679ff233">
                    <view class="cou-money data-v-679ff233" wx:if="{{item.$orig.type==3}}">
                        <text class="cou-pic data-v-679ff233">0</text>元购</view>
                    <view class="cou-money data-v-679ff233" wx:else>￥<text class="cou-pic data-v-679ff233">{{item.$orig.quota}}</text>
                    </view>
                    <view class="cou-pictit data-v-679ff233" wx:if="{{item.$orig.type==2&&item.$orig.threshold==0}}">无门槛</view>
                    <view class="cou-pictit data-v-679ff233" wx:if="{{item.$orig.type==1&&item.$orig.threshold>0}}">{{'满'+item.$orig.threshold+'元可用'}}</view>
                    <view class="cou-pictit data-v-679ff233" wx:if="{{item.$orig.type==3}}">{{'已抵扣('+item.$orig.deductionUsedNum+'/'+item.$orig.deductionTotalNum+')'}}</view>
                </view>
                <view class="cou-l-r data-v-679ff233">
                    <view class="cou-title data-v-679ff233">{{item.$orig.name}}</view>
                    <view class="cou-date data-v-679ff233" style="color:#ADADAD;" wx:if="{{item.$orig.useTimeSlot==0}}">{{item.f0+'-'+item.f1}}</view>
                    <view class="cou-date data-v-679ff233" style="color:#ADADAD;" wx:if="{{item.$orig.useTimeSlot==1}}">{{item.f2+'前有效'}}</view>
                    <view class="cou-date data-v-679ff233" style="color:#ADADAD;" wx:if="{{item.$orig.useTimeSlot==2}}">{{item.f3+'-'+item.f4}}</view>
                    <view class="cou-date data-v-679ff233" style="color:#ADADAD;" wx:if="{{item.$orig.useTimeSlot==2}}">{{'可预订【'+item.f5+'-'+item.f6+'】的'+(item.$orig.itemType==1?'门票':'产品')}}</view>
                </view>
                <view class="cou-r data-v-679ff233">
                    <view class="cou-rbox data-v-679ff233">
                        <view bindtap="__e" class="cou-btn data-v-679ff233" data-event-opts="{{[ [ 'tap',[ [ 'jumpUse',['$0'],[ [ ['orderList','',index] ] ] ] ] ] ]}}">立即使用</view>
                        <view class="data-v-679ff233" style="width:120rpx;text-align:right;">
                            <image bindtap="__e" class="showbtn data-v-679ff233" data-event-opts="{{[ [ 'tap',[ [ 'showList',['$0'],[ [ ['orderList','',index,'userCouponId'] ] ] ] ] ] ]}}" src="https://eshopfile.zhiyousx.com/170065269243227630.png" wx:if="{{item.$orig.isShow}}"></image>
