<view class="u-wrap data-v-59618206">
    <view class="u-search-box data-v-59618206">
        <view bindtap="__e" class="u-search-inner data-v-59618206" data-event-opts="{{[ [ 'tap',[ [ 'goSearch',['$event'] ] ] ] ]}}">
            <u-icon bind:__l="__l" class="data-v-59618206" color="#909399" name="search" size="{{28}}" vueId="712c99e0-1"></u-icon>
            <text class="u-search-text data-v-59618206">搜索商品</text>
        </view>
    </view>
    <view class="u-menu-wrap data-v-59618206" wx:if="{{$root.g0>0}}">
        <scroll-view class="u-tab-view menu-scroll-view data-v-59618206" scrollTop="{{scrollTop}}" scrollWithAnimation="{{true}}" scrollY="{{true}}">
            <view catchtap="__e" class="{{['u-tab-item','data-v-59618206',current==index?'u-tab-item-active':'']}}" data-current="{{index}}" data-event-opts="{{[ [ 'tap',[ [ 'swichMenu',[index] ] ] ] ]}}" wx:for="{{tabbar}}" wx:key="index">
                <text class="u-line-1 data-v-59618206">{{item.catName}}</text>
            </view>
        </scroll-view>
        <scroll-view class="right-box data-v-59618206" scrollY="{{true}}">
            <block wx:if="{{tabbar[current].children}}">
                <view class="classifyBanner data-v-59618206" wx:if="{{$root.g1>0}}">
                    <u-swiper bind:__l="__l" bind:click="__e" borderRadius="16" class="data-v-59618206" data-event-opts="{{[ [ '^click',[ ['swiperClick'] ] ] ]}}" height="200" indicatorActiveColor="#ff4643" indicatorPos="bottomRight" interval="5000" list="{{tabbar[current].adverts}}" name="advertPicUrl" vueId="712c99e0-2"></u-swiper>
                </view>
                <view class="page-view data-v-59618206" wx:if="{{item.children}}" wx:for="{{tabbar[current].children}}" wx:key="index">
                    <view class="class-item data-v-59618206">
                        <view class="item-title data-v-59618206">
                            <text class="data-v-59618206">{{item.catName}}</text>
                        </view>
                        <view class="item-container data-v-59618206">
                            <view bindtap="__e" class="thumb-box data-v-59618206" data-event-opts="{{[ [ 'tap',[ [ 'goGoodsList',['$0'],[ [ ['tabbar.'+current+'.children','',index],['children','',index1,'catId'] ] ] ] ] ] ]}}" wx:for="{{item.children}}" wx:for-index="index1" wx:for-item="item1" wx:key="index1">
                                <image class="item-menu-image data-v-59618206" lazyLoad="{{true}}" mode="scaleToFill" src="{{item1.iconPic?item1.iconPic:'https://eshopfile.zhiyousx.com/2023102620364973049.png'}}"></image>
                                <view class="item-menu-name data-v-59618206">{{item1.catName}}</view>
                            </view>
                        </view>
                    </view>
                </view>
            </block>
            <view class="empty data-v-59618206" wx:else>
                <u-empty bind:__l="__l" class="data-v-59618206" marginTop="100" text="暂无分类" vueId="712c99e0-3"></u-empty>
            </view>
        </scroll-view>
    </view>
</view>
