.agreement-content{color:#000;font-size:15px;line-height:24px;margin:16px 0 0}.agreement-content scroll-view{height:calc(512px - constant(safe-area-inset-bottom));height:calc(512px - env(safe-area-inset-bottom))}.agreement-title{font-size:15px;font-size:calc(15px + .5*(1rem - 16px));position:relative;text-align:center}.agreement-close{background-image:url(data:image/svg+xml;base64,);background-position:10px 10px;background-repeat:no-repeat;height:24px;left:-18px;padding:10px;position:absolute;top:-10px;width:24px}