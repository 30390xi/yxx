.wxlive-player-pendant{letter-spacing:1px}.wxlive-player-pendant__mini-screen{align-items:center;background-color:#fff;border-radius:8px;box-shadow:0 3px 10px 0 rgba(0,0,0,.3);display:-webkit-flex;display:flex;height:72px;justify-content:center;position:relative;width:88px}.wxlive-player-pendant__screen{background-color:red;border-radius:inherit;height:calc(100% - 8px);position:relative;width:calc(100% - 8px)}.wxlive-player-pendant__mini-screen__info{align-items:center;background-color:rgba(0,0,0,.4);border-radius:inherit;bottom:0;color:#fff;display:-webkit-flex;display:flex;flex-direction:column;font-size:12px;font-weight:450;justify-content:center;left:0;position:absolute;right:0;top:0}.wxlive-player-pendant__icon-advance,.wxlive-player-pendant__icon-play,.wxlive-player-pendant__icon-playing{height:24px;margin-bottom:2px;width:24px}.wxlive-player-pendant__icon-playing{background:url(https://res.wx.qq.com/a/fed_upload/9b2b0b54-8adf-448d-beb1-05a8dd160f46/living.svg)no-repeat 50%/contain}.wxlive-player-pendant__icon-play{background:url(https://res.wx.qq.com/a/fed_upload/9b2b0b54-8adf-448d-beb1-05a8dd160f46/playback.svg)no-repeat 50%/contain}.wxlive-player-pendant__icon-advance{background:url(https://res.wx.qq.com/a/fed_upload/9b2b0b54-8adf-448d-beb1-05a8dd160f46/advance.svg)no-repeat 50%/contain}.wxlive-player-pendant__explain .wxlive-player-pendant__explain__inner{align-items:center;background-image:linear-gradient(180deg,rgba(0,0,0,.7),rgba(0,0,0,.9));border-radius:18px;box-shadow:0 3px 10px 0 rgba(0,0,0,.3);color:#fff;display:-webkit-flex;display:flex;font-size:12px;font-weight:450;justify-content:center;line-height:32px;padding:0 12px;width:-webkit-fit-content;width:fit-content}.wxlive-player-pendant__explain .wxlive-player-pendant__icon{margin-right:2px}