<view class="chat-input-bar-container data-v-02d04554" style="{{'padding-bottom:'+(isIos?'':'30rpx')+';'}}">
    <view class="chat-select-ask data-v-02d04554">
        <scroll-view class="chat-select-scroll data-v-02d04554" scrollX="{{true}}" scrollY="{{false}}">
            <view bindtap="__e" class="{{['chat-select-item','data-v-02d04554',!pushingProgressShow?'forbidden':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'resetTravel',['$event'] ] ] ] ]}}">AI旅行规划</view>
            <view bindtap="__e" class="{{['chat-select-item','data-v-02d04554',!pushingProgressShow?'forbidden':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'goHistory',['$event'] ] ] ] ]}}" wx:if="{{!isHistory}}">历史攻略记录</view>
        </scroll-view>
    </view>
    <view class="chat-input-bar data-v-02d04554">
        <view class="Hold_Talk data-v-02d04554" wx:if="{{showSpeakBtn==2}}">
            <image bindtap="__e" class="icon_keyboard data-v-02d04554" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}" lazyLoad="false" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173397023959707764.png"></image>
            <view bindtouchend="__e" bindtouchstart="__e" class="speakBtn data-v-02d04554" data-event-opts="{{[ [ 'touchstart',[ [ 'keystart',['$event'] ] ] ],[ 'touchend',[ [ 'stopVoice',['$event'] ] ] ] ]}}">按住说话</view>
        </view>
        <view class="Hold_Talk_f data-v-02d04554" wx:if="{{showSpeakBtn==3}}">
            <image class="icon_keyboard data-v-02d04554" lazyLoad="false" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173397098176315734.png"></image>
        </view>
        <view class="chat-input-container data-v-02d04554" wx:if="{{showSpeakBtn==1}}">
            <image bindtap="__e" class="icon data-v-02d04554" data-event-opts="{{[ [ 'tap',[ [ 'getSpeak',['$event'] ] ] ] ]}}" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173396938595977761.png"></image>
            <input adjustPosition="{{false}}" bindconfirm="__e" bindinput="__e" class="chat-input data-v-02d04554" confirmType="send" cursorSpacing="{{50}}" data-event-opts="{{[ [ 'confirm',[ [ 'sendClick',['$event'] ] ] ],[ 'input',[ [ '__set_model',[ '','msg','$event',[] ] ] ] ] ]}}" focus="{{focus}}" placeholder="请输入您的问题" type="text" value="{{msg}}"></input>
        </view>
        <view class="right-btn data-v-02d04554">
            <image bindtap="__e" class="chat-input-send1 data-v-02d04554" data-event-opts="{{[ [ 'tap',[ [ 'sendClick',['$event'] ] ] ] ]}}" lazyLoad="false" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173397265137741758.png" wx:if="{{showSpeakBtn==1&&pushingProgress}}"></image>
            <image bindtap="__e" class="chat-input-send data-v-02d04554" data-event-opts="{{[ [ 'tap',[ [ 'setcolse',['$event'] ] ] ] ]}}" lazyLoad="false" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173396943581483214.png" wx:if="{{!showHide&&(showSpeakBtn==1||showSpeakBtn==2||showSpeakBtn==3)&&delayBtn&&pushingProgress}}"></image>
        </view>
    </view>
    <view class="prompt data-v-02d04554">内容由AI生成，无法确保真实准确，仅供参考</view>
    <view class="layer-box data-v-02d04554">
        <view class="prompt-layer data-v-02d04554" wx:if="{{longPress}}">
            <view class="prompt-loader data-v-02d04554">
                <view class="em data-v-02d04554" wx:for="{{15}}" wx:key="index"></view>
            </view>
            <text class="p data-v-02d04554">{{value}}</text>
            <text class="span data-v-02d04554">松手结束录音</text>
        </view>
    </view>
    <view bindtap="__e" class="stopBtn data-v-02d04554" data-event-opts="{{[ [ 'tap',[ [ 'stopSpeak',['$event'] ] ] ] ]}}" wx:if="{{!pushingProgressShow&&!isStrategy}}">
        <image class="icon data-v-02d04554" lazyLoad="false" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173406333510840071.png"></image>停止回答</view>
</view>
