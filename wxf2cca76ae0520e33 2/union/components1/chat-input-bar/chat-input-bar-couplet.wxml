<view class="chat-input-bar-container data-v-23ff1ac8" style="{{'padding-bottom:'+(isIos?'':'30rpx')+';'}}">
    <view class="chat-input-bar data-v-23ff1ac8">
        <view class="Hold_Talk data-v-23ff1ac8" wx:if="{{showSpeakBtn==2}}">
            <image bindtap="__e" class="icon_keyboard data-v-23ff1ac8" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}" lazyLoad="false" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173649100402573140.png"></image>
            <view bindtouchend="__e" bindtouchstart="__e" class="speakBtn data-v-23ff1ac8" data-event-opts="{{[ [ 'touchstart',[ [ 'keystart',['$event'] ] ] ],[ 'touchend',[ [ 'stopVoice',['$event'] ] ] ] ]}}">按住说话</view>
        </view>
        <view class="Hold_Talk_f data-v-23ff1ac8" wx:if="{{showSpeakBtn==3}}">
            <image class="icon_keyboard data-v-23ff1ac8" lazyLoad="false" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173397098176315734.png"></image>
        </view>
        <view class="chat-input-container data-v-23ff1ac8" wx:if="{{showSpeakBtn==1}}">
            <image bindtap="__e" class="icon data-v-23ff1ac8" data-event-opts="{{[ [ 'tap',[ [ 'getSpeak',['$event'] ] ] ] ]}}" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173647646699774432.png"></image>
            <input adjustPosition="{{false}}" bindconfirm="__e" bindinput="__e" class="chat-input data-v-23ff1ac8" confirmType="send" cursorSpacing="{{50}}" data-event-opts="{{[ [ 'confirm',[ [ 'sendClick',['$event'] ] ] ],[ 'input',[ [ '__set_model',[ '','msg','$event',[] ] ] ] ] ]}}" focus="{{focus}}" placeholder="发送消息" placeholderClass="title_input" type="text" value="{{msg}}"></input>
        </view>
        <view class="right-btn data-v-23ff1ac8">
            <image bindtap="__e" class="chat-input-send1 data-v-23ff1ac8" data-event-opts="{{[ [ 'tap',[ [ 'sendClick',['$event'] ] ] ] ]}}" lazyLoad="false" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173649024780235604.png" wx:if="{{showSpeakBtn==1&&pushingProgress}}"></image>
            <image bindtap="__e" class="chat-input-send data-v-23ff1ac8" data-event-opts="{{[ [ 'tap',[ [ 'setcolse',['$event'] ] ] ] ]}}" lazyLoad="false" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173647643421949005.png" wx:if="{{!showHide&&showSpeakBtn==1||showSpeakBtn==2||showSpeakBtn==3}}"></image>
        </view>
    </view>
    <view class="prompt data-v-23ff1ac8">内容由AI生成，无法确保真实准确，仅供参考</view>
    <view class="layer-box data-v-23ff1ac8">
        <view class="prompt-layer data-v-23ff1ac8" wx:if="{{longPress}}">
            <view class="prompt-loader data-v-23ff1ac8">
                <view class="em data-v-23ff1ac8" wx:for="{{15}}" wx:key="index"></view>
            </view>
            <text class="p data-v-23ff1ac8">{{value}}</text>
            <text class="span data-v-23ff1ac8">松手结束录音</text>
        </view>
    </view>
    <view bindtap="__e" class="stopBtn data-v-23ff1ac8" data-event-opts="{{[ [ 'tap',[ [ 'stopSpeak',['$event'] ] ] ] ]}}" wx:if="{{!pushingProgressShow}}">
        <image class="icon data-v-23ff1ac8" lazyLoad="false" mode="aspectFill" src="https://eshopfile.zhiyousx.com/173406333510840071.png"></image>停止对春联</view>
</view>
