<view class="replacement_box data-v-0f1a54f8">
    <uni-navbar bind:__l="__l" class="data-v-0f1a54f8" type="transparentFixed" vueId="3e21584a-1"></uni-navbar>
    <view class="replacement_header data-v-0f1a54f8"></view>
    <view class="replacement_count-box data-v-0f1a54f8">
        <view class="replacement_count-top data-v-0f1a54f8"></view>
        <view class="replacement_count-bottom data-v-0f1a54f8"></view>
        <view class="replacement_count data-v-0f1a54f8" style="{{'bottom:'+(smallScreen?'200rpx':'220rpx')+';'+'height:'+(smallScreen?'520rpx':'840rpx')+';'}}" wx:if="{{$root.g0}}">
            <view class="video-box data-v-0f1a54f8" wx:for="{{dataList}}" wx:for-index="i" wx:for-item="el" wx:key="id">
                <view class="loading-box data-v-0f1a54f8" wx:if="{{el.status==0}}">
                    <view class="loading-warp data-v-0f1a54f8">
                        <view class="loading-top data-v-0f1a54f8"></view>
                        <image class="loading-bottom data-v-0f1a54f8" src="https://eshopfile.zhiyousx.com/173762708353241951.png"></image>
                    </view>
                </view>
                <image bindtap="__e" class="swiperItem data-v-0f1a54f8" data-event-opts="{{[ [ 'tap',[ [ 'playVideo',['$0','$1'],[ [ ['dataList','id',el.id,'videoUrl'] ],[ ['dataList','id',el.id,'imageUrl'] ] ] ] ] ] ]}}" mode="aspectFill" src="{{el.imageUrl}}" wx:else></image>
            </view>
        </view>
        <view class="replacement_count data-v-0f1a54f8" style="{{'bottom:'+(smallScreen?'200rpx':'220rpx')+';'+'height:'+(smallScreen?'520rpx':'840rpx')+';'}}" wx:else>
            <view class="no-data data-v-0f1a54f8">当前暂无作品</view>
        </view>
    </view>
    <view class="replacement_foot data-v-0f1a54f8">
        <view class="btn-all data-v-0f1a54f8">
            <view class="foot-sub data-v-0f1a54f8">
                <view bindtap="__e" class="foot-btn data-v-0f1a54f8" data-event-opts="{{[ [ 'tap',[ [ 'submit',['$event'] ] ] ] ]}}">创作视频</view>
            </view>
        </view>
        <view bindtap="__e" class="refresh-icon data-v-0f1a54f8" data-event-opts="{{[ [ 'tap',[ [ 'getDataList',['$event'] ] ] ] ]}}" wx:if="{{$root.g1}}"></view>
    </view>
    <view bindtap="__e" class="video-boxs data-v-0f1a54f8" data-event-opts="{{[ [ 'tap',[ [ 'parentMethod',['$event'] ] ] ] ]}}" hidden="{{!showPlay}}">
        <image mode bindtap="__e" class="close-btn data-v-0f1a54f8" data-event-opts="{{[ [ 'tap',[ [ '',['$event'] ] ] ] ]}}" src="https://eshopfile.zhiyousx.com/173752928421185517.png"></image>
        <view bindtap="__e" class="foot-btn foot-btn1 data-v-0f1a54f8" data-event-opts="{{[ [ 'tap',[ [ 'download',['$event'] ] ] ] ]}}" id="close">下载视频</view>
        <video autoplay="{{true}}" bindtap="__e" class="{{['swiperItemVideo','data-v-0f1a54f8','vue-ref',smallScreen?'video1':'video2']}}" controls="{{true}}" data-event-opts="{{[ [ 'tap',[ [ 'stopPropagation',['$event'] ] ] ] ]}}" data-ref="video" id="videoDome" objectFit="cover" poster="{{option.imageUrl}}" src="{{option.videoUrl}}"></video>
    </view>
</view>
