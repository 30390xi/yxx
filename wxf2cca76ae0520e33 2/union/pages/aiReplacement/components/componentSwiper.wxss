.swiperPanel{margin:0rpx auto;overflow:hidden;position:relative;width:630rpx}.swiperPanel .swiperItem{height:100%;left:0;position:absolute;top:0;transition:all .5s;width:100%}.swiperPanel .swiperItem .children{height:100%;margin:2rpx auto;position:relative}.swiperPanel .swiperItem .children .pic{border-radius:20px;height:100%;width:100%}.swiperPanel .swiperItem .children .selected{bottom:10%;height:80rpx;left:50%;position:absolute;transform:translate(-50%);width:80rpx}.swiperPanel .swiperItem .children .name{background:rgba(0,0,0,.5);border-radius:0 0 20px 20px;bottom:0;box-shadow:0rpx 4rpx 21rpx 0rpx rgba(0,0,0,.07);color:#fff;font-family:Source Han Sans SC;font-size:32rpx;font-style:normal;font-weight:400;height:85rpx;left:0;line-height:85rpx;position:absolute;text-align:center;text-transform:none;width:100%}