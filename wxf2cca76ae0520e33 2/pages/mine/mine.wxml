<view class="page-box data-v-5bf8cba4">
    <view class="{{['header','data-v-5bf8cba4',!isAndroid?'apple':'']}}">
        <view class="headerBg data-v-5bf8cba4">
            <view class="data-v-5bf8cba4" style="{{navgateHeight}}">我的</view>
        </view>
        <view class="information data-v-5bf8cba4">
            <view class="left data-v-5bf8cba4">
                <view bindtap="__e" class="Photo data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'information',['$event'] ] ] ] ]}}">
                    <image class="data-v-5bf8cba4" src="{{userInfo.picUrl?userInfo.picUrl:'https://eshopfile.zhiyousx.com/2021120914511172601.png'}}" wx:if="{{userInfo}}"></image>
                    <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/2021120914511172601.png" wx:else></image>
                </view>
                <view class="nickName data-v-5bf8cba4">
                    <block wx:if="{{userInfo}}">
                        <view class="n data-v-5bf8cba4">{{''+(userInfo.nickName?userInfo.nickName:'')+''}}<view bindtap="__e" class="goodshare data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goWealth',['$event'] ] ] ] ]}}" wx:if="{{userInfo.isFenxiao}}">
                                <image class="data-v-5bf8cba4" mode="heightFix" src="https://eshopfile.zhiyousx.com/2021111810193639516.png"></image>旅行达人</view>
                        </view>
                        <view class="data-v-5bf8cba4">{{$root.f0}}</view>
                    </block>
                    <view bindtap="__e" class="data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goLogin',['$event'] ] ] ] ]}}" wx:else>登录/注册</view>
                </view>
            </view>
        </view>
        <view class="shopcart data-v-5bf8cba4">
            <view bindtap="__e" class="option data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goshoppingCart',['$event'] ] ] ] ]}}">
                <view class="num data-v-5bf8cba4">{{wealthNum.cartNum||0}}</view>
                <view class="name data-v-5bf8cba4">购物车</view>
            </view>
            <view bindtap="__e" class="option data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goDiscounts',['$event'] ] ] ] ]}}">
                <view class="num data-v-5bf8cba4">{{wealthNum.couponCount||0}}</view>
                <view class="name data-v-5bf8cba4">优惠券</view>
            </view>
            <view bindtap="__e" class="option data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goGiftCard',['$event'] ] ] ] ]}}">
                <view class="num data-v-5bf8cba4">{{wealthNum.giftCardNum||0}}</view>
                <view class="name data-v-5bf8cba4">礼品卡</view>
            </view>
            <view bindtap="__e" class="option data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goMyeqCard',['$event'] ] ] ] ]}}">
                <view class="num data-v-5bf8cba4">{{cardNum||0}}</view>
                <view class="name data-v-5bf8cba4">权益卡</view>
            </view>
            <view bindtap="__e" class="option data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goYearCard',['$event'] ] ] ] ]}}">
                <view class="num data-v-5bf8cba4">{{wealthNum.userYearCardNum||0}}</view>
                <view class="name data-v-5bf8cba4">年卡</view>
            </view>
        </view>
        <view bindtap="__e" class="wealth data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goWealth',['$event'] ] ] ] ]}}">
            <view class="Cash-out data-v-5bf8cba4">
                <view class="data-v-5bf8cba4">我的总收益<text class="t m data-v-5bf8cba4">￥</text>
                    <text class="t data-v-5bf8cba4">{{wealthNum.accountIncome||0}}</text>
                </view>
                <view class="data-v-5bf8cba4" wx:if="{{userInfo.isFenxiao}}">合伙人后台</view>
            </view>
            <view class="money data-v-5bf8cba4">
                <view class="moneys data-v-5bf8cba4">
                    <view class="describe data-v-5bf8cba4">可提现</view>
                    <view class="number numberRed data-v-5bf8cba4">
                        <text class="data-v-5bf8cba4" style="color:#FF4643;">￥</text>
                        <text class="data-v-5bf8cba4" style="color:#ff4643;font-size:36rpx;">{{wealthNum.accountBalance||0}}</text>
                    </view>
                </view>
                <view class="moneys data-v-5bf8cba4">
                    <view class="describe data-v-5bf8cba4">结算中</view>
                    <view class="number data-v-5bf8cba4">
                        <text class="data-v-5bf8cba4">￥</text>
                        <text class="data-v-5bf8cba4" style="color:#333;font-size:36rpx;">{{wealthNum.brokerageIncome||0}}</text>
                    </view>
                </view>
                <view class="moneys data-v-5bf8cba4">
                    <view class="describe data-v-5bf8cba4">已提现</view>
                    <view class="number data-v-5bf8cba4" style="font-size:36rpx;">
                        <text class="data-v-5bf8cba4">￥</text>
                        <text class="data-v-5bf8cba4" style="color:#333;font-size:36rpx;">{{wealthNum.accountWithdraw||0}}</text>
                    </view>
                </view>
            </view>
        </view>
    </view>
    <view class="order data-v-5bf8cba4">
        <view class="details data-v-5bf8cba4">
            <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goMyorder',[1] ] ] ] ]}}">
                <view class="iconbox data-v-5bf8cba4">
                    <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/2021111817111705800.png"></image>
                    <u-badge bgColor="#ff4643" bind:__l="__l" class="data-v-5bf8cba4" count="{{orderNum.waitPay}}" offset="{{[-10,-10]}}" vueId="bae1c640-1" wx:if="{{orderNum}}"></u-badge>
                </view>
                <text class="data-v-5bf8cba4">待付款</text>
            </view>
            <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goMyorder',[2] ] ] ] ]}}">
                <view class="iconbox data-v-5bf8cba4">
                    <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/2021111817113322154.png"></image>
                    <u-badge bgColor="#ff4643" bind:__l="__l" class="data-v-5bf8cba4" count="{{orderNum.waitDelivered}}" offset="{{[-10,-10]}}" vueId="bae1c640-2" wx:if="{{orderNum}}"></u-badge>
                </view>
                <text class="data-v-5bf8cba4">待发货</text>
            </view>
            <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goMyorder',[3] ] ] ] ]}}">
                <view class="iconbox data-v-5bf8cba4">
                    <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/2021111817115635468.png"></image>
                    <u-badge bgColor="#ff4643" bind:__l="__l" class="data-v-5bf8cba4" count="{{orderNum.pendingReceipt}}" offset="{{[-10,-10]}}" vueId="bae1c640-3" wx:if="{{orderNum}}"></u-badge>
                </view>
                <text class="data-v-5bf8cba4">待收货</text>
            </view>
            <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goAfterSales',['$event'] ] ] ] ]}}">
                <view class="iconbox data-v-5bf8cba4">
                    <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/2021111817122324138.png"></image>
                </view>
                <text class="data-v-5bf8cba4">退换/售后</text>
            </view>
            <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'goMyorder',[0] ] ] ] ]}}">
                <view class="iconbox data-v-5bf8cba4">
                    <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/2021111817104193057.png"></image>
                </view>
                <text class="data-v-5bf8cba4">我的订单</text>
            </view>
        </view>
    </view>
    <view class="list data-v-5bf8cba4" style="{{openAppConfig.paramValue==1?'margin-bottom:110rpx;':''}}">
        <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'talent',['$event'] ] ] ] ]}}" wx:if="{{(!userInfo||!userInfo.isFenxiao)&&openFenxiaoConfig}}">
            <view class="conItem data-v-5bf8cba4">
                <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/170065378457808945.png"></image>
                <view class="news data-v-5bf8cba4">成为旅行达人</view>
            </view>
            <view class="iconbox data-v-5bf8cba4">
                <uni-icons bind:__l="__l" class="data-v-5bf8cba4" color="#c8c8c8" type="arrowright" vueId="bae1c640-4"></uni-icons>
            </view>
        </view>
        <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'collection',['$event'] ] ] ] ]}}">
            <view class="conItem data-v-5bf8cba4">
                <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/2023120417452973207.png"></image>
                <view class="news data-v-5bf8cba4">我的收藏</view>
            </view>
            <view class="iconbox data-v-5bf8cba4">
                <uni-icons bind:__l="__l" class="data-v-5bf8cba4" color="#c8c8c8" type="arrowright" vueId="bae1c640-5"></uni-icons>
            </view>
        </view>
        <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'passenger',['$event'] ] ] ] ]}}">
            <view class="conItem data-v-5bf8cba4">
                <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/170065376301138571.png"></image>
                <view class="news data-v-5bf8cba4">常用旅客</view>
            </view>
            <view class="iconbox data-v-5bf8cba4">
                <uni-icons bind:__l="__l" class="data-v-5bf8cba4" color="#c8c8c8" type="arrowright" vueId="bae1c640-6"></uni-icons>
            </view>
        </view>
        <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'news',['$event'] ] ] ] ]}}">
            <view class="conItem data-v-5bf8cba4">
                <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/170065380405498216.png"></image>
                <view class="news data-v-5bf8cba4">消息中心</view>
            </view>
            <view class="iconbox data-v-5bf8cba4">
                <text class="badgeBox data-v-5bf8cba4" wx:if="{{messageNum}}">{{messageNum||''}}</text>
                <uni-icons bind:__l="__l" class="data-v-5bf8cba4" color="#c8c8c8" type="arrowright" vueId="bae1c640-7"></uni-icons>
            </view>
        </view>
        <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'security',['$event'] ] ] ] ]}}">
            <view class="conItem data-v-5bf8cba4">
                <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/170065372343017335.png"></image>
                <view class="news data-v-5bf8cba4">账户安全</view>
            </view>
            <view class="iconbox data-v-5bf8cba4">
                <uni-icons bind:__l="__l" class="data-v-5bf8cba4" color="#c8c8c8" type="arrowright" vueId="bae1c640-8"></uni-icons>
            </view>
        </view>
        <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'feedback',['$event'] ] ] ] ]}}">
            <view class="conItem data-v-5bf8cba4">
                <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/170065384377493595.png"></image>
                <view class="news data-v-5bf8cba4">问题反馈</view>
            </view>
            <view class="iconbox data-v-5bf8cba4">
                <uni-icons bind:__l="__l" class="data-v-5bf8cba4" color="#c8c8c8" type="arrowright" vueId="bae1c640-9"></uni-icons>
            </view>
        </view>
        <view bindtap="__e" class="contents data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'about',['$event'] ] ] ] ]}}">
            <view class="conItem data-v-5bf8cba4">
                <image class="data-v-5bf8cba4" src="https://eshopfile.zhiyousx.com/170065334814754280.png"></image>
                <view class="news data-v-5bf8cba4">关于我们</view>
            </view>
            <view class="iconbox data-v-5bf8cba4">
                <uni-icons bind:__l="__l" class="data-v-5bf8cba4" color="#c8c8c8" type="arrowright" vueId="bae1c640-10"></uni-icons>
            </view>
        </view>
    </view>
    <view class="openApp data-v-5bf8cba4" wx:if="{{openAppConfig.paramValue==1&&false}}">
        <text class="data-v-5bf8cba4">{{openAppConfig.paramName||'打开游陕西APP，海量门票优惠购'}}</text>
        <button appParameter="wechat" binderror="__e" class="data-v-5bf8cba4" data-event-opts="{{[ [ 'error',[ [ 'launchAppError',['$event'] ] ] ] ]}}" openType="launchApp">立即前往</button>
    </view>
    <tab-bar bind:__l="__l" class="data-v-5bf8cba4" vueId="bae1c640-11"></tab-bar>
    <view class="wrapper data-v-5bf8cba4" style="position:fixed;z-index:9999;" wx:if="{{showPoster}}">
        <view bindtap="__e" class="bg data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}"></view>
        <canvas canvasId="firstCanvas" class="data-v-5bf8cba4" style="position:relative;height:1140rpx;width:640rpx;top:50%;margin-top:-570rpx;margin-left:55rpx;backgroundColor:#FFFFFF;z-index:10;"></canvas>
        <view catchtap="__e" class="save data-v-5bf8cba4" data-event-opts="{{[ [ 'tap',[ [ 'saveImg',['$event'] ] ] ] ]}}">保存海报</view>
    </view>
</view>
