@import "/_commons/21.wxss";.activity-card{overflow:hidden}.activity-card__item{border-radius:16px;color:#fff;display:inline-block;font-size:14px;line-height:32px;overflow:hidden;position:relative;transform:translate3d(-100%,0,0)}.activity-card__item__store .activity-card__item__inner{padding:0 12px 0 9px}.activity-card__item__inner{align-items:center;background-color:var(--color-theme-disabled);border-radius:inherit;display:-webkit-flex;display:flex;justify-content:flex-start;padding:0 12px}.activity-card__item__info__nickname{display:inline-block;max-width:5em;overflow:hidden;text-overflow:ellipsis;vertical-align:top;white-space:nowrap}@-webkit-keyframes fadeInOutActivity{0%{transform:translate3d(-100%,0,0)}10%{transform:translateZ(0)}90%{transform:translateZ(0)}to{transform:translate3d(-100%,0,0)}}@keyframes fadeInOutActivity{0%{transform:translate3d(-100%,0,0)}10%{transform:translateZ(0)}90%{transform:translateZ(0)}to{transform:translate3d(-100%,0,0)}}.activity-card__item.fadeInOut{animation:fadeInOutActivity 2s 1 forwards}.activity-card__item__icon{display:inline-block;height:17px;margin-right:6px;width:15px}.activity-card__item__icon__store{background:url(https://res.wx.qq.com/a/fed_upload/c984d63b-d88b-4978-8c13-4631667aa199/store_purple.svg)no-repeat 50%;display:inline-block;height:20px;margin-right:3px;position:relative;top:-1px;width:20px}.activity-card__item__info{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}