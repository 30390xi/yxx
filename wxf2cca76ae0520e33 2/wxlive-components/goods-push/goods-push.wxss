@font-face{font-family:WeChatSansStd-Medium;src:url(https://res.wx.qq.com/a/wx_fed/cdn_libs/res/WeChatSans/1.1.0/WeChatSansStd-Medium.ttf)}.activity-store-card{margin-top:8px;position:relative;transform:translate3d(-100%,0,0);z-index:1}.activity-store-card.fadeIn{animation:fadeInStoreCard .2s 1 forwards}.activity-store-card.fadeOut{animation:fadeOutStoreCard .2s 1 forwards}.activity-store-card__inner{position:relative;z-index:1}@-webkit-keyframes fadeInStoreCard{0%{transform:scale(0)}to{transform:scale(1)}}@keyframes fadeInStoreCard{0%{transform:scale(0)}to{transform:scale(1)}}@-webkit-keyframes fadeOutStoreCard{0%{transform:scale(1)}to{transform:scale(0)}}@keyframes fadeOutStoreCard{0%{transform:scale(1)}to{transform:scale(0)}}.activity-store-card__item{background-color:#fff;border-radius:4px;box-sizing:border-box;padding:5px;position:relative;width:100%}.activity-store-card__item__head{margin-right:6px}.activity-store-card__arrow{background-color:#fff;border-radius:2px;bottom:0;content:" ";display:block;height:9px;margin-bottom:-3.5px;position:absolute;transform:rotate(45deg);width:9px}.activity-store-card__with-noarrow .activity-store-card__item:after{opacity:0}.activity-store-card__item__inner{align-items:center;display:-webkit-flex;display:flex;justify-content:flex-start}.activity-store-card__item__avatar{border-radius:2px;display:block;height:56px;width:56px}.activity-store-card__item__body{align-items:flex-start;display:-webkit-flex;display:flex;flex-direction:column;height:56px;width:calc(100% - 63px)}.activity-store-card__item__title{color:#000;display:block;font-size:15px;opacity:.7;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%}.activity-store-card__item__price{color:#fa9d3b;font-family:WeChatSansStd-Medium;font-size:14px;opacity:.9}.activity-store-card__item__price-before{color:#b2b2b2;font-family:WeChatSansStd-Medium;font-size:14px;margin-left:4px;text-decoration:line-through}.activity-store-card__vertical .activity-store-card__arrow{left:16px}.activity-store-card__vertical.activity-store-card__with-comment .activity-store-card__arrow{left:182px}.activity-store-card__sell-status{align-items:center;color:var(--color-theme);display:-webkit-flex;display:flex;font-size:12px}.activity-store-card__item__tag{background-image:linear-gradient(#ff8d7c,#ff6e53,#ff6d54,#ff6b52,#ff5d40);border-radius:4px;box-sizing:border-box;color:hsla(0,0%,100%,.9);display:inline-block;font-weight:450;height:21px;line-height:21px;margin-right:8px;min-width:115px;padding:0 4px;text-align:center}.activity-store-card__with-seckill .activity-store-card__item__price{margin-bottom:8px;margin-top:4px}.activity-store-card__with-seckill .activity-store-card__item__body{height:85px;width:calc(100% - 85px)}.activity-store-card__with-seckill .activity-store-card__item__avatar{height:85px;width:85px}.activity-store-card__horizontal .activity-store-card__item{box-sizing:border-box;width:calc(100% - 78px)}.activity-store-card__horizontal .activity-store-card__inner{display:-webkit-flex;display:flex;justify-content:flex-end}