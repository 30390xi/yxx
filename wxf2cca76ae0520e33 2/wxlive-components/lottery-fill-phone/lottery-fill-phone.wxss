.input-half-panel__header__operation{background-color:var(--color-theme);border-radius:14px;color:var(--color-light);font-size:14px;line-height:28px;margin-top:16px;position:absolute;right:0;text-align:center;top:0;width:52px}.input-half-panel__header__operation.disabled{background-color:var(--color-theme-disabled)}.input-half-panel__header__operation.disabled:active{opacity:1}.input-half-panel__header__operation:active{opacity:.7}.input-half-panel__input-container{align-items:center;background-color:var(--bgColor-input);border-radius:4px;display:-webkit-flex;display:flex;height:44px;padding-left:12px}