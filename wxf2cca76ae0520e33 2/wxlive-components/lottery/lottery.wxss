.lottery{font-size:14px}.lottery__inner{align-items:center;display:-webkit-flex;display:flex;flex-direction:column;position:relative}.lottery__icon{height:47px;width:41px}.lottery__icon:after{background:url(https://res.wx.qq.com/a/fed_upload/f3810538-8906-4b81-907e-d7940200a326/lottery_end.png)no-repeat 50%/contain;content:" ";display:block;height:94px;left:-21px;pointer-events:none;position:absolute;top:-37px;width:84px}.lottery__icon__end{background:none;background-size:contain;height:47px;position:relative;width:41px}.lottery__icon__end:after{background:url(https://res.wx.qq.com/a/fed_upload/f3810538-8906-4b81-907e-d7940200a326/reward_icon.png)no-repeat 50%/contain;content:" ";display:block;height:94px;left:-24px;pointer-events:none;position:absolute;top:-36px;width:82px}.lottery__info{background-color:rgba(0,0,0,.25);border-radius:10px;box-sizing:border-box;color:hsla(0,0%,100%,.9);height:20px;line-height:20px;margin-top:5px;text-align:center;width:51px}.lottery__info.lottery__status{font-size:12px;line-height:21px;min-width:51px;padding:0 5px;width:auto}.lottery__info.empty{background:none}.lottery__icon__empty{background-size:contain;height:47px;width:41px}.lottery__animation{display:inline-block;left:-20px;pointer-events:none;position:absolute;top:-36px;will-change:transform}.lottery__team__status{align-items:flex-end;background-image:url(https://res.wx.qq.com/a/fed_upload/198422a7-e66f-4765-8e37-a22c66d2592c/lotteryTeamStatus.png);background-position:50%;background-repeat:no-repeat;background-size:contain;border-radius:9px;bottom:23px;color:#fff;display:-webkit-flex;display:flex;font-size:10px;height:20px;justify-content:center;left:-1px;line-height:18px;position:absolute;text-align:center;width:52px}.lottery__team__status__word{font-weight:450}