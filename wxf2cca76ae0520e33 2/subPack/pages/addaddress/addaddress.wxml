    <button bindtap="__e" class="loginSub data-v-1c18590e" data-event-opts="{{[ [ 'tap',[ [ 'submit',['$event'] ] ] ] ]}}" disabled="{{loadingStatus}}" loading="{{loadingStatus}}">保存</button>
    <button bindtap="__e" class="registerSub data-v-1c18590e" data-event-opts="{{[ [ 'tap',[ [ 'delAddress',['$event'] ] ] ] ]}}" wx:if="{{addrId}}">删除地址</button>
</view>
