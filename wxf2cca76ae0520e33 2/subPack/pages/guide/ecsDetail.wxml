<view class="page-box data-v-39227df4" wx:if="{{spotDetail}}">
    <view class="top-box data-v-39227df4" wx:if="{{imgList[0]}}">
        <u-swiper autoplay="{{false}}" bind:__l="__l" borderRadius="0" class="data-v-39227df4" height="450" indicatorPos="topRight" interval="5000" list="{{imgList}}" name="imgUrl" vueId="931dd8dc-1"></u-swiper>
        <view class="title-box data-v-39227df4">
            <view class="title data-v-39227df4">{{''+langData.name+''}}</view>
            <view class="dic data-v-39227df4" wx:if="{{spotDetail.distance}}">
                <label class="_span data-v-39227df4" wx:if="{{langType=='zn'}}">距您</label>{{spotDetail.distance+'km'}}</view>
        </view>
    </view>
    <view class="noImg data-v-39227df4" wx:else>
        <view class="noImg-title-box data-v-39227df4">
            <view class="noImg-title data-v-39227df4">{{''+langData.name+''}}</view>
            <view class="noImg-dic data-v-39227df4" wx:if="{{spotDetail.distance}}">
                <label class="_span data-v-39227df4" wx:if="{{langType=='zn'}}">距您</label>{{spotDetail.distance+'km'}}</view>
        </view>
    </view>
    <view class="content data-v-39227df4">
        <u-parse bind:__l="__l" bind:imgtap="__e" class="data-v-39227df4 vue-ref" data-event-opts="{{[ [ '^imgtap',[ ['imgtap'] ] ] ]}}" data-ref="article" html="{{langData.introduction}}" lazyLoad="{{true}}" style="text-align:justify;" tagStyle="{{parseStyle}}" vueId="931dd8dc-2"></u-parse>
    </view>
    <view class="audio-box data-v-39227df4" wx:if="{{langData.voiceUrl}}">
        <view class="border-Box data-v-39227df4" style="{{'background:'+'url('+mapinfo.voiceBottomUrl+') no-repeat'+';'+'background-size:'+'100% 100%'+';'}}">
            <view class="audio-wrapper data-v-39227df4">
                <view class="audio-number-box data-v-39227df4">
                    <text class="anb1 data-v-39227df4" style="{{'color:'+'#65470D'+';'}}">{{$root.m0}}</text>
                    <view class="div data-v-39227df4">/</view>
                    <text class="anb2 data-v-39227df4" style="{{'color:'+'#957F66'+';'}}">{{$root.m1}}</text>
                </view>
                <slider activeColor="#65470D" backgroundColor="rgba(0,0,0,0.1)" bindchange="__e" bindchanging="__e" blockColor="{{mapinfo.audioTitleBg}}" blockSize="16" class="audio-slider data-v-39227df4" data-event-opts="{{[ [ 'changing',[ [ 'e0',['$event'] ] ] ],[ 'change',[ [ 'e1',['$event'] ] ] ] ]}}" max="{{duration}}" value="{{current}}"></slider>
            </view>
            <image alt bindtap="__e" class="audio-but _img data-v-39227df4" data-event-opts="{{[ [ 'tap',[ ['play'] ] ] ]}}" src="{{mapinfo.voicePlayStyle}}" wx:if="{{paused}}"></image>
            <image alt bindtap="__e" class="audio-but _img data-v-39227df4" data-event-opts="{{[ [ 'tap',[ [ 'e2',['$event'] ] ] ] ]}}" src="{{mapinfo.voiceSuspendStyle}}" wx:else></image>
        </view>
    </view>
    <view class="foot-box data-v-39227df4">
        <button class="data-v-39227df4" openType="share" style="{{styleConfig.btn}}">
            <view class="border-Box data-v-39227df4" style="{{'color:'+mapinfo.fontUnselectedColor+';'}}">
                <image alt class="share data-v-39227df4" mode="widthFix" src="{{mapinfo.shareBtnIcon}}"></image>{{''+(langType=='zn'?'分享':'Share')+''}}</view>
        </button>
        <button bindtap="__e" class="data-v-39227df4" data-event-opts="{{[ [ 'tap',[ [ 'jumpLocation',['$event'] ] ] ] ]}}" style="{{styleConfig.actbtn}}">
            <view class="border-Box data-v-39227df4" style="{{'color:'+mapinfo.fontUnselectedColor+';'}}">
                <image alt class="jump data-v-39227df4" mode="widthFix" src="{{mapinfo.navBtnIcon}}"></image>{{''+(langType=='zn'?'去这里':'Go')+''}}</view>
        </button>
    </view>
    <view bindtap="__e" class="banckMap data-v-39227df4" data-event-opts="{{[ [ 'tap',[ [ 'toGuide',['$event'] ] ] ] ]}}" wx:if="{{showGuideBut}}">
        <image mode class="data-v-39227df4" src="https://eshopfile.zhiyousx.com/2023031610322750615.png"></image>{{''+(langType=='zn'?'导览':'Guide')+''}}</view>
</view>
