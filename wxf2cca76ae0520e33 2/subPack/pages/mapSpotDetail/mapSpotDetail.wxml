<view class="page-box data-v-7bb9408c" wx:if="{{spotDetail}}">
    <view class="top-box data-v-7bb9408c" wx:if="{{imgList[0]}}">
        <u-swiper autoplay="{{false}}" bind:__l="__l" borderRadius="0" class="data-v-7bb9408c" height="450" indicatorPos="topRight" interval="5000" list="{{imgList}}" name="imgUrl" vueId="4c6a84b6-1"></u-swiper>
        <view class="title-box data-v-7bb9408c">
            <view class="title data-v-7bb9408c">{{''+langData.name+''}}</view>
            <view class="dic data-v-7bb9408c" wx:if="{{spotDetail.distance}}">
                <label class="_span data-v-7bb9408c" wx:if="{{langType=='zn'}}">距您</label>{{spotDetail.distance+'km'}}</view>
        </view>
    </view>
    <view class="noImg data-v-7bb9408c" wx:else>
        <view class="noImg-title-box data-v-7bb9408c">
            <view class="noImg-title data-v-7bb9408c">{{''+langData.name+''}}</view>
            <view class="noImg-dic data-v-7bb9408c" wx:if="{{spotDetail.distance}}">
                <label class="_span data-v-7bb9408c" wx:if="{{langType=='zn'}}">距您</label>{{spotDetail.distance+'km'}}</view>
        </view>
    </view>
    <view class="audio-box data-v-7bb9408c" wx:if="{{langData.voiceUrl}}">
        <view class="audio-wrapper data-v-7bb9408c">
            <view class="audio-number-box data-v-7bb9408c">
                <text class="anb1 data-v-7bb9408c">{{$root.m0}}</text>
                <view class="div data-v-7bb9408c">/</view>
                <text class="anb2 data-v-7bb9408c">{{$root.m1}}</text>
            </view>
            <slider activeColor="#35ABAD" backgroundColor="#ADC6D8" bindchange="__e" bindchanging="__e" blockSize="16" class="audio-slider data-v-7bb9408c" data-event-opts="{{[ [ 'changing',[ [ 'e0',['$event'] ] ] ],[ 'change',[ [ 'e1',['$event'] ] ] ] ]}}" max="{{duration}}" value="{{current}}"></slider>
        </view>
        <image alt bindtap="__e" class="audio-but _img data-v-7bb9408c" data-event-opts="{{[ [ 'tap',[ ['play'] ] ] ]}}" hidden="{{!paused}}" src="https://eshopfile.zhiyousx.com/2023031610511320054.png"></image>
        <image alt bindtap="__e" class="audio-but _img data-v-7bb9408c" data-event-opts="{{[ [ 'tap',[ [ 'e2',['$event'] ] ] ] ]}}" hidden="{{!!paused}}" src="https://eshopfile.zhiyousx.com/2023031610514447151.png"></image>
    </view>
    <view class="content data-v-7bb9408c">
        <u-parse bind:__l="__l" class="data-v-7bb9408c vue-ref" data-ref="article" html="{{langData.introduction}}" lazyLoad="{{true}}" style="text-align:justify;" tagStyle="{{parseStyle}}" vueId="4c6a84b6-2" vueSlots="{{['default']}}">
            <text class="data-v-7bb9408c" style="display:inline-block;"></text>
        </u-parse>
    </view>
    <view class="foot-box data-v-7bb9408c">
        <button class="data-v-7bb9408c" openType="share">
            <image alt class="share _img data-v-7bb9408c" src="https://eshopfile.zhiyousx.com/2023031610300944943.png"></image>{{''+(langType=='zn'?'分享':'Share')+''}}</button>
        <button bindtap="__e" class="data-v-7bb9408c" data-event-opts="{{[ [ 'tap',[ [ 'jumpLocation',['$event'] ] ] ] ]}}">
            <image alt class="jump _img data-v-7bb9408c" src="https://eshopfile.zhiyousx.com/2023031610293382013.png"></image>{{''+(langType=='zn'?'去这里':'Go')+''}}</button>
    </view>
    <view bindtap="__e" class="banckMap data-v-7bb9408c" data-event-opts="{{[ [ 'tap',[ [ 'toGuide',['$event'] ] ] ] ]}}" wx:if="{{showGuideBut}}">
        <image mode class="data-v-7bb9408c" src="https://eshopfile.zhiyousx.com/2023031610322750615.png"></image>{{''+(langType=='zn'?'导览':'Guide')+''}}</view>
</view>
