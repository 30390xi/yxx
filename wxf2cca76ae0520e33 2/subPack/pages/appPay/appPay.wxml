<view class="page-box data-v-1bd3db7c">
    <view class="info-box data-v-1bd3db7c">
        <view class="text data-v-1bd3db7c">{{''+payMsg+''}}</view>
        <image mode class="icon data-v-1bd3db7c" src="https://eshopfile.zhiyousx.com/2023061917344246662.png"></image>
