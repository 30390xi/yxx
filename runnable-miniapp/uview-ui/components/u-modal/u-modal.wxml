<view class="data-v-e7b2f758">
    <u-popup bind:__l="__l" bind:close="__e" bind:input="__e" borderRadius="{{borderRadius}}" class="data-v-e7b2f758" data-event-opts="{{[ [ '^close',[ ['popupClose'] ] ],[ '^input',[ [ '__set_model',[ '','value','$event',[] ] ] ] ] ]}}" length="{{width}}" maskCloseAble="{{maskCloseAble}}" mode="center" popup="{{false}}" value="{{value}}" vueId="e28dbccc-1" vueSlots="{{['default']}}" zIndex="{{uZIndex}}" zoom="{{zoom}}">
        <view class="u-model data-v-e7b2f758">
            <view class="u-model-title u-line-1 data-v-e7b2f758" style="{{$root.s0}}" wx:if="{{showTitle}}">{{title}}</view>
            <view class="u-model-content data-v-e7b2f758">
                <view class="data-v-e7b2f758" style="{{$root.s1}}" wx:if="{{$slots.default}}">
                    <slot></slot>
                </view>
                <view class="u-model-content-message data-v-e7b2f758" style="{{$root.s2}}" wx:else>{{content}}</view>
            </view>
            <view class="u-model-footer u-border-top data-v-e7b2f758" wx:if="{{showCancelButton||showConfirmButton}}">
                <view bindtap="__e" class="u-model-footer-button data-v-e7b2f758" data-event-opts="{{[ [ 'tap',[ [ 'cancel',['$event'] ] ] ] ]}}" hoverClass="btn-hover" hoverStayTime="{{100}}" style="{{$root.s3}}" type="default" wx:if="{{showCancelButton}}">{{''+cancelText+''}}</view>
                <view bindtap="__e" class="u-model-footer-button hairline-left data-v-e7b2f758" data-event-opts="{{[ [ 'tap',[ [ 'confirm',['$event'] ] ] ] ]}}" hoverClass="{{asyncClose?'none':'btn-hover'}}" hoverStayTime="{{100}}" style="{{$root.s4}}" wx:if="{{showConfirmButton}}">
                    <u-loading bind:__l="__l" class="data-v-e7b2f758" color="{{confirmColor}}" mode="circle" vueId="{{'e28dbccc-2'+','+'e28dbccc-1'}}" wx:if="{{loading}}"></u-loading>
                    <block wx:else>{{''+confirmText+''}}</block>
                </view>
            </view>
        </view>
    </u-popup>
</view>
