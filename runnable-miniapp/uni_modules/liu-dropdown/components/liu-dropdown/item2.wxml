<view class="item-main data-v-676cac44" style="{{height?'height:'+height+'rpx;':''}}">
    <view class="item-list data-v-676cac44">
        <scroll-view class="item-left data-v-676cac44" scrollY="true">
            <view catchtap="__e" class="item-left-list data-v-676cac44" data-event-opts="{{[ [ 'tap',[ [ 'chooseLeft',[index] ] ] ] ]}}" style="{{selectLeftIndex==index?'color:'+themeColor+';background: #FFFFFF;border-radius:0rpx;':''}}" wx:for="{{newList}}" wx:key="index">{{item.name+''}}</view>
        </scroll-view>
        <scroll-view class="item-right data-v-676cac44" scrollIntoView="{{scrollIntoView}}" scrollWithAnimation="{{true}}" scrollY="true">
            <view class="item-right-list data-v-676cac44" id="{{index!='#'?index:'BOTTOM'}}" wx:for="{{$root.l0}}" wx:key="index">
                <view class="left-item-title data-v-676cac44" wx:if="{{item.g0}}">{{index}}</view>
                <view catchtap="__e" class="item-right-list-name data-v-676cac44" data-event-opts="{{[ [ 'tap',[ [ 'selectRight',['$0'],[ [ ['scrollLeftObj','',index],['','',inx] ] ] ] ] ] ]}}" wx:for="{{item.$orig}}" wx:for-index="inx" wx:for-item="mess">
                    <view class="item-right-list-name-info data-v-676cac44" style="{{mess.chooseState?'color:'+themeColor:''}}">{{''+mess.name+''}}</view>
                    <image class="item-right-list-img data-v-676cac44" src="../../static/select.png" wx:if="{{mess.chooseState}}"></image>
                </view>
            </view>
        </scroll-view>
        <view class="liu-scroll-right data-v-676cac44">
            <view catchtap="__e" class="{{['data-v-676cac44',true?'liu-scroll-right-name':'',item==scrollIntoView?'liu-scroll-right-select':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'chooseType',['$0'],[ [ ['scrollRightList','',index] ] ] ] ] ] ]}}" style="{{item==scrollIntoView?'background: '+themeColor:''}}" wx:for="{{scrollRightList}}" wx:key="index">{{item+''}}</view>
        </view>
    </view>
    <view class="btn-list data-v-676cac44">
        <view catchtap="__e" class="btn-reset data-v-676cac44" data-event-opts="{{[ [ 'tap',[ [ 'reset',['$event'] ] ] ] ]}}">重置</view>
        <view catchtap="__e" class="btn-complete data-v-676cac44" data-event-opts="{{[ [ 'tap',[ [ 'complete',['$event'] ] ] ] ]}}" style="{{'background: '+themeColor}}">完成</view>
    </view>
</view>
