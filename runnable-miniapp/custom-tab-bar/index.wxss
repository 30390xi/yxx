.tab-bar{position:fixed;left:0;right:0;bottom:0;z-index:1000;height:110rpx;background:#fff;border-top:1rpx solid #eee;display:flex;align-items:center;justify-content:space-around;padding-bottom:env(safe-area-inset-bottom);box-sizing:content-box}
.tab{width:25%;height:100rpx;display:flex;flex-direction:column;align-items:center;justify-content:center}
.icon{width:46rpx;height:46rpx}
.label{font-size:22rpx;line-height:30rpx;color:#777;margin-top:4rpx}
.label.active{color:#ff5411;font-weight:600}
