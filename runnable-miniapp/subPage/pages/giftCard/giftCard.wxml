        </view>
    </u-popup>
    <u-popup bind:__l="__l" bind:input="__e" borderRadius="20" class="data-v-4a5cfa80" closeable="{{true}}" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '','showTip','$event',[] ] ] ] ] ]}}" mode="center" value="{{showTip}}" vueId="57487260-4" vueSlots="{{['default']}}">
        <view class="popup-tips data-v-4a5cfa80">{{''+$root.f1+''}}</view>
    </u-popup>
