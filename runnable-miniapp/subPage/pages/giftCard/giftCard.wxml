                                <view class="item-orderId data-v-4a5cfa80">{{'订单：'+item.orderId+''}}</view>
                                <view class="item-time data-v-4a5cfa80">{{''+item.createTime+''}}</view>
                            </view>
                            <view class="item-right data-v-4a5cfa80">
                                <view class="{{['item-change','data-v-4a5cfa80',item.balanceChange>0?'add':'']}}">
                                    <text class="data-v-4a5cfa80" style="color:#FF5411;" wx:if="{{item.balanceChange>0}}">+</text>{{item.balanceChange+''}}</view>
                                <view class="item-balance data-v-4a5cfa80">{{'余：'+item.balance+''}}</view>
                            </view>
                        </view>
                    </scroll-view>
                </view>
            </view>
            <view bindtap="__e" class="but data-v-4a5cfa80" data-event-opts="{{[ [ 'tap',[ [ 'closePopup',['$event'] ] ] ] ]}}">知道了</view>
        </view>
    </u-popup>
    <u-popup bind:__l="__l" bind:input="__e" borderRadius="20" class="data-v-4a5cfa80" closeable="{{true}}" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '','buyPop','$event',[] ] ] ] ] ]}}" mode="center" value="{{buyPop}}" vueId="57487260-3" vueSlots="{{['default']}}">
