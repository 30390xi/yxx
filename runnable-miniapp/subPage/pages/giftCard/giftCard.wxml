            <view class="card-number data-v-4a5cfa80">{{'卡号：'+cardId+''}}</view>
            <view class="record data-v-4a5cfa80">
                <view class="name data-v-4a5cfa80">消费记录：</view>
                <view class="no-record data-v-4a5cfa80" wx:if="{{$root.g1}}">
