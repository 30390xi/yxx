            <view class="t data-v-4a5cfa80">购买新卡</view>
        </view>
        <view bindtap="__e" class="item data-v-4a5cfa80" data-event-opts="{{[ [ 'tap',[ [ 'bindCard',['$event'] ] ] ] ]}}">
