                            <view class="tips data-v-4a5cfa80">{{''+item.f0+''}}</view>
                            <image mode class="tips-icon data-v-4a5cfa80" src="../../static/images/info.png"></image>
                        </view>
                    </view>
                </view>
            </view>
            <image mode class="card-state data-v-4a5cfa80" src="https://eshopfile.zhiyousx.com/170065250008116634.png" wx:if="{{item.$orig.status==3}}"></image>
            <image mode class="card-state data-v-4a5cfa80" src="https://eshopfile.zhiyousx.com/170065251327546322.png" wx:if="{{item.$orig.status==4}}"></image>
            <image mode class="card-state data-v-4a5cfa80" src="https://eshopfile.zhiyousx.com/170065252675437017.png" wx:if="{{item.$orig.status==6}}"></image>
            <image mode class="card-state data-v-4a5cfa80" src="https://eshopfile.zhiyousx.com/170065254044085555.png" wx:if="{{item.$orig.status==5}}"></image>
        </view>
        <view class="no-card data-v-4a5cfa80" wx:if="{{$root.g0}}">
            <image mode class="no-card-icon data-v-4a5cfa80" src="https://eshopfile.zhiyousx.com/giftCard/noGiftCard.png"></image>{{'您暂无'+(currentTab==1?'不':'')+'可用的礼品卡'}}</view>
    </view>
    <view class="footer data-v-4a5cfa80">
        <view bindtap="__e" class="item data-v-4a5cfa80" data-event-opts="{{[ [ 'tap',[ [ 'buyCard',['$event'] ] ] ] ]}}">
