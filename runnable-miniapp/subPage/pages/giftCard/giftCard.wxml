            <view class="money data-v-4a5cfa80">{{'￥'+sumBalance+''}}</view>
        </view>
        <view class="tab-box data-v-4a5cfa80">
            <u-tabs activeColor="#FF5411" barStyle="{{barStyle}}" bind:__l="__l" bind:change="__e" class="data-v-4a5cfa80 vue-ref" current="{{currentTab}}" data-event-opts="{{[ [ '^change',[ ['tabsChange'] ] ] ]}}" data-ref="uTabs" fontSize="28" inactiveColor="#555555" isScroll="{{false}}" list="{{tabTitle}}" vueId="57487260-1"></u-tabs>
        </view>
    </view>
    <view class="card-box data-v-4a5cfa80">
        <view class="card-box-it data-v-4a5cfa80" wx:if="{{records[0]}}" wx:for="{{$root.l0}}" wx:key="index">
            <view class="{{['card-item','data-v-4a5cfa80',currentTab==1?'filterBox':'']}}">
                <image mode class="card-image data-v-4a5cfa80" src="{{item.$orig.cardPicUrl}}" wx:if="{{item.$orig.cardPicUrl}}"></image>
                <view class="card-data data-v-4a5cfa80">
                    <view class="{{['card-head','data-v-4a5cfa80',!item.$orig.cardPicUrl?'cardHeadbg':'']}}">
                        <image mode class="card-logo data-v-4a5cfa80" src="../../static/images/logo.png" wx:if="{{!item.$orig.cardPicUrl}}"></image>
                        <view class="card-info data-v-4a5cfa80">
                            <view class="card-name data-v-4a5cfa80">{{''+item.$orig.name+''}}</view>
                            <view class="card-value data-v-4a5cfa80">{{'面值：'+item.$orig.quota+'元'}}</view>
                        </view>
                        <view bindtap="__e" class="card-log data-v-4a5cfa80" data-event-opts="{{[ [ 'tap',[ [ 'getGiftCardDetail',['$0'],[ [ ['records','',index] ] ] ] ] ] ]}}">消费记录</view>
                        <view class="card-time data-v-4a5cfa80">{{''+item.$orig.validityTimeStr+''}}</view>
                    </view>
                    <view class="{{['card-body','data-v-4a5cfa80',!item.$orig.cardPicUrl?'cardBodyBg':'']}}">
                        <view class="card-balance data-v-4a5cfa80">
                            <text class="label data-v-4a5cfa80">余额</text>
                            <text class="value data-v-4a5cfa80">{{'￥'+item.$orig.balance}}</text>
                        </view>
