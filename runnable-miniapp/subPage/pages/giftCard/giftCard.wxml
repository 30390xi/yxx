            <view class="t data-v-4a5cfa80">绑定新卡</view>
        </view>
    </view>
    <u-popup bind:__l="__l" bind:input="__e" borderRadius="20" class="data-v-4a5cfa80" closeable="{{true}}" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '','show','$event',[] ] ] ] ] ]}}" mode="center" value="{{show}}" vueId="57487260-2" vueSlots="{{['default']}}">
