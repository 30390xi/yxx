<view class="data-v-73cbda65">
    <uni-navbar bgColor="#f8f8f8" bind:__l="__l" class="data-v-73cbda65" title="购物车" type="fixed" vueId="27be84c0-1"></uni-navbar>
    <view bindtap="__e" class="navRight data-v-73cbda65" data-event-opts="{{[ [ 'tap',[ [ 'onEditor',['$event'] ] ] ] ]}}" slot="left">{{isEditor?'编辑':'完成'}}</view>
    <view class="cardBox data-v-73cbda65">
        <block wx:if="{{$root.g0>0}}">
            <view class="cardItem data-v-73cbda65" wx:for="{{$root.l1}}" wx:key="index">
                <view class="merchant data-v-73cbda65">
                    <uni-icons bind:__l="__l" bind:click="__e" class="data-v-73cbda65" color="#ff4643" data-event-opts="{{[ [ '^click',[ [ 'storeCilck',['$0',index],[ [ ['shopCardList','',index,'selectedFlag'] ] ] ] ] ] ]}}" size="22" type="checkbox-filled" vueId="{{'27be84c0-2-'+index}}" wx:if="{{item.$orig.selectedFlag===1}}"></uni-icons>
                    <uni-icons bind:__l="__l" bind:click="__e" class="data-v-73cbda65" color="#878787" data-event-opts="{{[ [ '^click',[ [ 'storeCilck',['$0',index],[ [ ['shopCardList','',index,'selectedFlag'] ] ] ] ] ] ]}}" size="22" type="circle" vueId="{{'27be84c0-3-'+index}}" wx:else></uni-icons>
                    <view bindtap="__e" class="mcName data-v-73cbda65" data-event-opts="{{[ [ 'tap',[ [ 'goStore',['$0'],[ [ ['shopCardList','',index,'sellerId'] ] ] ] ] ] ]}}">
                        <image class="data-v-73cbda65" src="../../static/images/sj_icon.png"></image>
                        <text class="data-v-73cbda65">{{item.$orig.sellerName}}</text>
                        <uni-icons bind:__l="__l" class="data-v-73cbda65" color="#c8c8c8" size="14" type="arrowright" vueId="{{'27be84c0-4-'+index}}"></uni-icons>
                    </view>
                </view>
                <view class="cardGoods data-v-73cbda65" wx:for="{{item.l0}}" wx:for-index="childIndex" wx:for-item="childItem" wx:key="childIndex">
                    <uni-icons bind:__l="__l" bind:click="__e" class="data-v-73cbda65" color="#ff4643" data-event-opts="{{[ [ '^click',[ [ 'godsCilck',['$0',childIndex,index],[ [ ['shopCardList','',index],['cartItems','',childIndex,'selectedFlag'] ] ] ] ] ] ]}}" size="22" type="checkbox-filled" vueId="{{'27be84c0-5-'+index+'-'+childIndex}}" wx:if="{{childItem.$orig.selectedFlag===1}}"></uni-icons>
                    <uni-icons bind:__l="__l" bind:click="__e" class="data-v-73cbda65" color="#878787" data-event-opts="{{[ [ '^click',[ [ 'godsCilck',['$0',childIndex,index],[ [ ['shopCardList','',index],['cartItems','',childIndex,'selectedFlag'] ] ] ] ] ] ]}}" size="22" type="circle" vueId="{{'27be84c0-6-'+index+'-'+childIndex}}" wx:else></uni-icons>
                    <view class="caedLeft data-v-73cbda65">
                        <view bindtap="__e" class="cardImg data-v-73cbda65" data-event-opts="{{[ [ 'tap',[ [ 'goGoodsDetails',['$0'],[ [ ['shopCardList','',index],['cartItems','',childIndex,'itemId'] ] ] ] ] ] ]}}">
                            <u-lazy-load bind:__l="__l" class="data-v-73cbda65" height="180" image="{{childItem.$orig.picUrl}}" imgMode="scaleToFill" vueId="{{'27be84c0-7-'+index+'-'+childIndex}}"></u-lazy-load>
                        </view>
                        <view class="cardInfo data-v-73cbda65">
                            <view bindtap="__e" class="shopName multilineText2 data-v-73cbda65" data-event-opts="{{[ [ 'tap',[ [ 'goGoodsDetails',['$0'],[ [ ['shopCardList','',index],['cartItems','',childIndex,'itemId'] ] ] ] ] ] ]}}">{{childItem.$orig.itemName}}</view>
                            <view bindtap="__e" class="shopsku singleLineText data-v-73cbda65" data-event-opts="{{[ [ 'tap',[ [ 'goGoodsDetails',['$0'],[ [ ['shopCardList','',index],['cartItems','',childIndex,'itemId'] ] ] ] ] ] ]}}">{{childItem.$orig.skuName?childItem.$orig.skuName:''}}</view>
                            <view class="shopsku itemSubTitle data-v-73cbda65">{{childItem.$orig.itemSubTitle?childItem.$orig.itemSubTitle:''}}</view>
                            <view class="data-v-73cbda65" style="margin-top:15rpx;" wx:if="{{childItem.$orig.cashBackAmount&&childItem.$orig.cashBackAmount!=0}}">
                                <text class="itemRuter data-v-73cbda65">{{'返￥'+childItem.$orig.cashBackAmount}}</text>
                            </view>
                            <view class="prceNum data-v-73cbda65">
                                <text bindtap="__e" class="data-v-73cbda65" data-event-opts="{{[ [ 'tap',[ [ 'goGoodsDetails',['$0'],[ [ ['shopCardList','',index],['cartItems','',childIndex,'itemId'] ] ] ] ] ] ]}}">{{'￥'+childItem.f0}}</text>
                                <uni-number-box bind:__l="__l" bind:change="__e" childIndex="{{childIndex}}" class="numberBox data-v-73cbda65" data-event-opts="{{[ [ '^change',[ ['bindNumChange'] ] ] ]}}" max="{{200}}" min="{{1}}" parentIndex="{{index}}" value="{{childItem.$orig.quantity}}" vueId="{{'27be84c0-8-'+index+'-'+childIndex}}"></uni-number-box>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
        </block>
        <view class="cardItem data-v-73cbda65" wx:if="{{$root.g1>0}}">
            <view class="merchant data-v-73cbda65">
                <view class="failure data-v-73cbda65">
                    <text class="data-v-73cbda65">失效商品</text>
                    <text bindtap="__e" class="data-v-73cbda65" data-event-opts="{{[ [ 'tap',[ [ 'delFailure',['$event'] ] ] ] ]}}" style="color:#ff4643;">清空失效商品</text>
                </view>
            </view>
            <view class="cardGoods data-v-73cbda65" wx:for="{{$root.l2}}" wx:key="index">
                <view class="fText data-v-73cbda65">失效</view>
                <view class="caedLeft data-v-73cbda65">
                    <view class="cardImg data-v-73cbda65">
                        <u-lazy-load bind:__l="__l" class="data-v-73cbda65" height="180" image="{{item.$orig.picUrl}}" imgMode="scaleToFill" vueId="{{'27be84c0-9-'+index}}"></u-lazy-load>
                    </view>
                    <view class="cardInfo data-v-73cbda65">
                        <view class="shopName multilineText2 data-v-73cbda65">{{item.$orig.itemName}}</view>
                        <view class="shopsku singleLineText data-v-73cbda65">{{item.$orig.skuName?item.$orig.skuName:''}}</view>
                        <view class="prceNum data-v-73cbda65">
                            <text class="data-v-73cbda65">{{'￥'+item.f1}}</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </view>
    <view class="cardNav data-v-73cbda65" wx:if="{{token}}">
        <view bindtap="__e" class="checkedAll data-v-73cbda65" data-event-opts="{{[ [ 'tap',[ [ 'allCilck',['$event'] ] ] ] ]}}">
            <uni-icons bind:__l="__l" class="data-v-73cbda65" color="#ff4643" size="22" type="checkbox-filled" vueId="27be84c0-10" wx:if="{{isCheckAll}}"></uni-icons>
            <uni-icons bind:__l="__l" class="data-v-73cbda65" color="#878787" size="22" type="circle" vueId="27be84c0-11" wx:else></uni-icons>
            <text class="data-v-73cbda65">全选</text>
        </view>
        <view class="cardSub data-v-73cbda65">
            <text class="data-v-73cbda65" wx:if="{{isEditor}}">{{'合计：￥'+$root.f2}}</text>
            <button bindtap="__e" class="subBtn data-v-73cbda65" data-event-opts="{{[ [ 'tap',[ [ 'goConfirm',['$event'] ] ] ] ]}}" wx:if="{{isEditor}}">{{'结算('+presentNum+')'}}</button>
            <button bindtap="__e" class="subBtn data-v-73cbda65" data-event-opts="{{[ [ 'tap',[ [ 'delCard',['$event'] ] ] ] ]}}" wx:else>{{'删除('+presentNum+')'}}</button>
        </view>
    </view>
    <block wx:if="{{$root.g2}}">
        <empty-state bind:__l="__l" class="data-v-73cbda65" imgUrl="/static/captured/51d17a011d27445c.png" text="购物车为空" vueId="27be84c0-12"></empty-state>
        <button bindtap="__e" class="loginSub data-v-73cbda65" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}" wx:if="{{!token}}">您还没有登录，请登录后查看购物车信息</button>
    </block>
    <u-toast bind:__l="__l" class="data-v-73cbda65 vue-ref" data-ref="uToast" vueId="27be84c0-13"></u-toast>
</view>
