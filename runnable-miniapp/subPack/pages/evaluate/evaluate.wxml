                <view class="goodsInfo data-v-8043881a">
                    <text class="multilineText2 data-v-8043881a">{{item.name}}</text>
                    <text class="data-v-8043881a">{{item.skuName?item.skuName:''}}</text>
                </view>
            </view>
            <u-input bind:__l="__l" bind:input="__e" class="data-v-8043881a" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '$0','commentContent','$event',[] ],[ [ ['commentList','',index] ] ] ] ] ] ]}}" maxlength="120" placeholder="分享购买心得给小伙伴吧" type="textarea" value="{{item.commentContent}}" vueId="{{'ecf28a14-2-'+index}}"></u-input>
