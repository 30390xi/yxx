<view class="loginBox data-v-eef1a8aa">
    <u-verification-code bind:__l="__l" bind:change="__e" class="data-v-eef1a8aa vue-ref" data-event-opts="{{[ [ '^change',[ ['codeChange'] ] ] ]}}" data-ref="uCode" seconds="60" vueId="1f3f2316-1"></u-verification-code>
    <view class="loginForm data-v-eef1a8aa">
        <u-form bind:__l="__l" class="data-v-eef1a8aa vue-ref" data-ref="uForm" errorType="{{errorType}}" model="{{loginForm}}" rules="{{rules}}" vueId="1f3f2316-2" vueSlots="{{['default']}}">
            <u-form-item bind:__l="__l" class="data-v-eef1a8aa" labelWidth="0" prop="username" vueId="{{'1f3f2316-3'+','+'1f3f2316-2'}}" vueSlots="{{['default']}}">
                <u-input bind:__l="__l" bind:input="__e" class="data-v-eef1a8aa" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '$0','username','$event',[] ],['loginForm'] ] ] ] ]}}" focus="{{true}}" maxlength="11" placeholder="请输入手机号" type="number" value="{{loginForm.username}}" vueId="{{'1f3f2316-4'+','+'1f3f2316-3'}}"></u-input>
            </u-form-item>
            <u-form-item bind:__l="__l" class="data-v-eef1a8aa" labelWidth="0" prop="code" vueId="{{'1f3f2316-5'+','+'1f3f2316-2'}}" vueSlots="{{['default','right']}}">
                <u-input bind:__l="__l" bind:input="__e" class="data-v-eef1a8aa" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '$0','code','$event',[] ],['loginForm'] ] ] ] ]}}" maxlength="6" placeholder="请输入验证码" type="number" value="{{loginForm.code}}" vueId="{{'1f3f2316-6'+','+'1f3f2316-5'}}"></u-input>
                <button bindtap="__e" class="codeStyle data-v-eef1a8aa" data-event-opts="{{[ [ 'tap',[ [ 'getCode',['$event'] ] ] ] ]}}" slot="right">{{codeTips}}</button>
            </u-form-item>
            <u-form-item bind:__l="__l" class="data-v-eef1a8aa" labelWidth="0" prop="password" vueId="{{'1f3f2316-7'+','+'1f3f2316-2'}}" vueSlots="{{['default']}}">
                <u-input bind:__l="__l" bind:input="__e" class="data-v-eef1a8aa" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '$0','password','$event',[] ],['loginForm'] ] ] ] ]}}" maxlength="8" passwordIcon="{{true}}" placeholder="新密码" type="password" value="{{loginForm.password}}" vueId="{{'1f3f2316-8'+','+'1f3f2316-7'}}"></u-input>
            </u-form-item>
            <button bindtap="__e" class="loginSub data-v-eef1a8aa" data-event-opts="{{[ [ 'tap',[ [ 'submit',['$event'] ] ] ] ]}}" disabled="{{loadingStatus}}" loading="{{loadingStatus}}">完成</button>
        </u-form>
    </view>
</view>
