<view class="data-v-6dda32cd">
    <view bindtap="__e" class="contents data-v-6dda32cd" data-event-opts="{{[ [ 'tap',[ [ 'tosystemnotice',[0] ] ] ] ]}}">
        <view class="left data-v-6dda32cd">
            <view class="imgbox data-v-6dda32cd">
                <image mode class="data-v-6dda32cd" src="/static/captured/2691d484c5709b74.png"></image>
                <u-badge bgColor="#ff463c" bind:__l="__l" class="badge data-v-6dda32cd" count="{{newsCount.msgCount}}" offset="{{[-3,-3]}}" overflowCount="999" type="error" vueId="1e680ab6-1" wx:if="{{newsCount}}"></u-badge>
            </view>
            <view class="text data-v-6dda32cd">
                <view class="t data-v-6dda32cd">
                    <text class="title data-v-6dda32cd">系统通知</text>
                    <text class="time data-v-6dda32cd">{{msgList?msgList.sysMsgPushVo.insidePushTime:''}}</text>
                </view>
                <view class="singleLineText data-v-6dda32cd">{{msgList?msgList.sysMsgPushVo.title:'暂无任何消息'}}</view>
            </view>
        </view>
    </view>
    <view bindtap="__e" class="contents data-v-6dda32cd" data-event-opts="{{[ [ 'tap',[ [ 'tosystemnotice',[1] ] ] ] ]}}">
        <view class="left data-v-6dda32cd">
            <view class="imgbox data-v-6dda32cd">
                <image mode class="data-v-6dda32cd" src="/static/captured/0f1cec299ff89dc0.png"></image>
                <u-badge bgColor="#ff463c" bind:__l="__l" class="badge data-v-6dda32cd" count="{{newsCount.operateCount}}" offset="{{[-3,-3]}}" overflowCount="999" type="error" vueId="1e680ab6-2" wx:if="{{newsCount}}"></u-badge>
            </view>
            <view class="text data-v-6dda32cd">
                <view class="t data-v-6dda32cd">
                    <text class="title data-v-6dda32cd">操作通知类</text>
                    <text class="time data-v-6dda32cd">{{operateList?operateList.createTime:''}}</text>
                </view>
                <view class="singleLineText data-v-6dda32cd">{{operateList?operateList.content:'暂无任何消息'}}</view>
            </view>
        </view>
    </view>
    <view bindtap="__e" class="contents data-v-6dda32cd" data-event-opts="{{[ [ 'tap',[ [ 'tosystemnotice',[2] ] ] ] ]}}">
        <view class="left data-v-6dda32cd">
            <view class="imgbox data-v-6dda32cd">
                <image mode class="data-v-6dda32cd" src="/static/captured/d6139ab4d1917808.png"></image>
                <u-badge bgColor="#ff463c" bind:__l="__l" class="badge data-v-6dda32cd" count="{{newsCount.performanceCount}}" offset="{{[-3,-3]}}" overflowCount="999" type="error" vueId="1e680ab6-3" wx:if="{{newsCount}}"></u-badge>
            </view>
            <view class="text data-v-6dda32cd">
                <view class="t data-v-6dda32cd">
                    <text class="title data-v-6dda32cd">业绩消息类</text>
                    <text class="time data-v-6dda32cd">{{performanceList?performanceList.createTime:''}}</text>
                </view>
                <view class="singleLineText data-v-6dda32cd">{{performanceList?performanceList.content:'暂无任何消息'}}</view>
            </view>
        </view>
    </view>
</view>
