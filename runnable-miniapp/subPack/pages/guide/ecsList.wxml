<view class="page-box data-v-a416990a">
    <view class="data-v-a416990a" wx:if="{{listData&&listData[0]}}">
        <view class="item-box data-v-a416990a" wx:for="{{$root.l1}}" wx:key="index">
            <view class="item-top data-v-a416990a" style="{{'background:'+mapinfo.audioTitleBg+';'}}">
                <image alt class="icon _img data-v-a416990a" hidden="{{!item.$orig.voiceIcon}}" src="{{item.$orig.voiceIcon}}"></image>{{''+item.$orig.base.name+''}}</view>
            <view class="item-body data-v-a416990a" style="{{'background:'+mapinfo.audioBarBg+';'}}" wx:for="{{item.l0}}" wx:for-index="i" wx:for-item="it" wx:key="i">
                <view bindtap="__e" class="item-body-l data-v-a416990a" data-event-opts="{{[ [ 'tap',[ [ 'toDetail',['$0'],[ [ ['listData','',index],['scenicSpotMapTagVOList','',i] ] ] ] ] ] ]}}">
                    <image class="spot-img data-v-a416990a" mode="aspectFill" src="{{it.g1[0]}}" wx:if="{{it.g0}}"></image>
                    <image class="spot-img data-v-a416990a" mode="aspectFill" src="{{it.$orig.picUrl}}" wx:if="{{it.g2}}"></image>
                    <view class="info-box data-v-a416990a" style="{{'width:'+(it.$orig.picUrl?'250rpx':'450rpx')+';'}}">
                        <view class="name singleLineText data-v-a416990a">{{''+it.$orig.base.name+''}}</view>
                        <view class="dic data-v-a416990a" wx:if="{{it.$orig.distance}}">
                            <label class="_span data-v-a416990a" wx:if="{{langType=='zn'}}">距您</label>{{it.$orig.distance+'km'}}</view>
                    </view>
                </view>
                <view class="item-body-r data-v-a416990a">
                    <view bindtap="__e" class="icon-box data-v-a416990a" data-event-opts="{{[ [ 'tap',[ [ 'jumpLocation',['$0'],[ [ ['listData','',index],['scenicSpotMapTagVOList','',i] ] ] ] ] ] ]}}">
                        <image alt class="icon1 _img data-v-a416990a" src="/static/captured/67f6b35f969d4e58.png"></image>
                        <view class="icon1-text data-v-a416990a">{{''+(langType=='zn'?'去这里':'Go')+''}}</view>
                    </view>
                    <view bindtap="__e" class="icon-box data-v-a416990a" data-event-opts="{{[ [ 'tap',[ [ 'toDetail',['$0'],[ [ ['listData','',index],['scenicSpotMapTagVOList','',i] ] ] ] ] ] ]}}">
                        <image alt class="icon1 _img data-v-a416990a" src="/static/captured/215636d32871312a.png"></image>
                        <view class="icon1-text data-v-a416990a">{{''+(langType=='zn'?'讲解':'Interpreter')+''}}</view>
                    </view>
                </view>
            </view>
        </view>
    </view>
    <empty bind:__l="__l" class="data-v-a416990a" text="暂无内容" vueId="54c494a5-1" wx:else></empty>
</view>
