<view class="groupAct data-v-74c2bbed">
    <uni-navbar bind:__l="__l" class="data-v-74c2bbed" type="transparentFixed" vueId="664fe4e4-1"></uni-navbar>
    <view class="imgbox data-v-74c2bbed">
