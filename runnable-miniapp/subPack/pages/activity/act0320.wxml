                    <view class="item a data-v-74c2bbed">{{carId[1]}}</view>
                    <view class="item b data-v-74c2bbed">{{carId[2]}}</view>
                    <view class="item c data-v-74c2bbed">{{carId[3]}}</view>
                    <view class="item d data-v-74c2bbed">{{carId[4]}}</view>
                    <view class="item e data-v-74c2bbed">{{carId[5]}}</view>
                    <view class="item f data-v-74c2bbed">{{carId[6]}}</view>
                    <view class="item g data-v-74c2bbed">{{carId[7]}}</view>
                </view>
                <view class="input-box data-v-74c2bbed">
