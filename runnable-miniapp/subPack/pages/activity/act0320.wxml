                        <view bindtap="__e" class="btn use data-v-74c2bbed" data-event-opts="{{[ [ 'tap',[ [ 'usecoupon',['$0'],[ [ ['discount','',__i0__] ] ] ] ] ] ]}}" wx:if="{{!noCarcode&&item.receiveState===1}}">去使用</view>
