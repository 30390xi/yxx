            <view class="todetail data-v-74c2bbed"></view>
        </view>
    </view>
    <image class="codeBg data-v-74c2bbed" mode="widthFix" src="/static/captured/786b9b26c1b4d517.jpg"></image>
    <u-keyboard bind:__l="__l" bind:backspace="__e" bind:change="__e" bind:input="__e" cancelText="收起" class="data-v-74c2bbed vue-ref" data-event-opts="{{[ [ '^backspace',[ ['backspace'] ] ],[ '^change',[ ['valChange'] ] ],[ '^input',[ [ '__set_model',[ '','showCarBoard','$event',[] ] ] ] ] ]}}" data-ref="uKeyboard" mask="{{false}}" mode="car" safeAreaInsetBottom="{{true}}" tips="车牌号" value="{{showCarBoard}}" vueId="664fe4e4-3"></u-keyboard>
