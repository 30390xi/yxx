        <view bindtap="__e" class="swiperBox data-v-74c2bbed" data-event-opts="{{[ [ 'tap',[ [ 'routerTo',['$0'],[ [ ['pictures','',__i1__,'target'] ] ] ] ] ] ]}}" wx:for="{{pictures}}" wx:for-index="__i1__">
            <view bindtap="__e" class="swiper data-v-74c2bbed" data-event-opts="{{[ [ 'tap',[ [ 'routerTo',['$0'],[ [ ['pictures','',__i1__,'target'] ] ] ] ] ] ]}}">
                <u-swiper bgColor="rgba(0,0,0,0)" bind:__l="__l" bind:click="__e" borderRadius="0" class="data-v-74c2bbed" data-event-opts="{{[ [ '^click',[ [ 'routerTo',['$0'],[ [ ['pictures','',__i1__,'target'] ] ] ] ] ] ]}}" height="480" imgMode="aspectFill" indicatorActiveColor="rgba(0,0,0,0)" indicatorColor="rgba(0,0,0,0)" interval="3000" list="{{item.list}}" name="url" vueId="{{'664fe4e4-2-'+__i1__}}"></u-swiper>
