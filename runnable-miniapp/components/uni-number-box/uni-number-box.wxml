<view class="uni-numbox data-v-4c40123c">
    <view bindtap="__e" class="uni-numbox__minus data-v-4c40123c" data-event-opts="{{[ [ 'tap',[ [ '_calcValue',['minus'] ] ] ] ]}}">
        <text class="{{['uni-numbox--text','data-v-4c40123c',inputValue<=min||disabled?'uni-numbox--disabled':'']}}">-</text>
    </view>
    <input bindblur="__e" bindinput="__e" class="uni-numbox__value data-v-4c40123c" data-event-opts="{{[ [ 'blur',[ [ '_onBlur',['$event'] ] ] ],[ 'input',[ [ '__set_model',[ '','inputValue','$event',[] ] ] ] ] ]}}" disabled="{{disabled}}" type="number" value="{{inputValue}}"></input>
    <view bindtap="__e" class="uni-numbox__plus data-v-4c40123c" data-event-opts="{{[ [ 'tap',[ [ '_calcValue',['plus'] ] ] ] ]}}">
        <text class="{{['uni-numbox--text','data-v-4c40123c',inputValue>=max||disabled?'uni-numbox--disabled':'']}}">+</text>
    </view>
</view>
