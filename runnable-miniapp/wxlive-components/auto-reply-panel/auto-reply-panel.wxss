.auto-reply-panel__header{text-align:center;width:100%}.auto-reply-panel__cell{align-items:center;color:var(--color-light);display:-webkit-flex;display:flex;font-size:15px;justify-content:space-between;margin-bottom:12px;margin-top:15px;padding:12px;position:relative}.auto-reply-panel__cell:after,.auto-reply-panel__cell:before{background-color:hsla(0,0%,100%,.2);content:" ";display:block;height:1px;left:12px;position:absolute;right:12px}.auto-reply-panel__cell:before{top:0;transform:scaleY(.5)}.auto-reply-panel__cell:after{bottom:0;transform:scaleY(.5)}.auto-reply-panel__desc{color:hsla(0,0%,100%,.4);font-size:12px;margin:12px 12px calc(12px + env(safe-area-inset-bottom))}.auto-reply-panel__horizontal .auto-reply-panel__desc{margin-bottom:32px}.auto-reply-panel__body{width:100%}