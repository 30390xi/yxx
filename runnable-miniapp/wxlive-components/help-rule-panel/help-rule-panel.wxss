.help-rule-panel__header{display:block;width:100vw}.help-rule-panel__body{color:hsla(0,0%,100%,.8);font-size:14px;line-height:1.4;padding:14px 24px 16px 39px}.help-rule-item{margin-bottom:24px;position:relative}.help-rule-item:before{background-color:var(--color-light);border-radius:50%;content:" ";height:2px;left:0;margin-left:-10px;position:absolute;top:8px;width:2px}.help-rule-item:last-child{margin-bottom:0}.help-rule-panel__pusher__body{line-height:1.45;padding:8px 24px 0}.help-rule-section{margin-bottom:24px}.help-rule-section__title{margin-bottom:8px}