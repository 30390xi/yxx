.advance-detail__container{bottom:0;left:0;position:fixed;right:0;top:0;z-index:21}.advance-detail__mask{align-items:center;background-color:rgba(0,0,0,.5);bottom:0;display:-webkit-flex;display:flex;flex-direction:column;justify-content:center;left:0;position:fixed;right:0;top:0}.advance-detail__inner{max-height:71.92vh;position:relative;width:calc(100% - 56px)}.advance-detail__panel{background-color:#fff;border-radius:8px;max-height:inherit;overflow:hidden;position:relative;width:100%;z-index:22}.advance-detail__content{box-sizing:border-box;max-height:inherit;overflow-y:auto;padding-bottom:86px}.advance-detail__image{border-radius:8px 8px 0 0;height:180px;left:0;position:absolute;right:0;top:0}.advance-detail__body{padding:24px 24px 12px}.advance-detail__title{color:rgba(0,0,0,.9);font-size:20px;font-weight:var(--font-weight-bold)}.advance-detail__info{color:rgba(0,0,0,.9);font-size:15px;line-height:1.6;margin-top:12px;text-align:justify;white-space:pre-wrap;word-break:break-all}.advance-detail__count-time{align-items:center;background:#fff;border-radius:0 0 8px 8px;bottom:0;box-shadow:0-6px 16px #fff;display:-webkit-flex;display:flex;left:0;padding:16px 32px;position:absolute;right:0}.advance-detail__count-time__body{flex:1}.advance-detail__count-time__title{color:rgba(0,0,0,.8);font-size:12px}.advance-detail__count-time__info{color:rgba(0,0,0,.9);font-size:20px;font-weight:var(--font-weight-bold)}.advance-detail__count-time__extend{align-items:center;background-color:var(--color-theme);border-radius:18px;color:#fff;display:-webkit-flex;display:flex;font-size:16px;font-weight:var(--font-weight-bold);justify-content:center;line-height:36px;padding:0 18px;position:relative}.advance-detail__count-time__extend:before{background:url(https://res.wx.qq.com/a/fed_upload/9c80118b-42a2-40b7-a292-c0d0dbe8f344/bell.svg)no-repeat 50%/contain;content:" ";display:block;height:16px;margin-right:2px;position:relative;width:16px}.advance-detail__count-time__extend:active:after{background-color:rgba(0,0,0,.1);border-radius:inherit;bottom:0;content:" ";display:block;left:0;position:absolute;right:0;top:0}.advance-detail__count-time__extend-disabled{background:rgba(0,0,0,.05);color:rgba(0,0,0,.2)}.advance-detail__count-time__extend-disabled:before{background:url(https://res.wx.qq.com/a/fed_upload/0b002705-6a3d-48a9-860f-4f81f51a87bd/bellDisabled.svg)no-repeat 50%/contain}.advance-detail__count-time__extend-disabled:active:after{display:none}.advance-detail__close{background:url(https://res.wx.qq.com/a/fed_upload/a6ec8059-0f95-4ada-ad4e-02280cc44229/close.svg)no-repeat 50%/contain;bottom:0;height:44px;left:50%;margin-bottom:-68px;margin-left:-20px;position:absolute;width:44px}.advance-detail__close:active{opacity:.7}.advance-detail__image .advance-detail__body{padding-top:204px}@media screen and (max-height:670px){.advance-detail__image,.advance-detail__video,.advance-detail__video-content{height:120px}.advance-detail__image .advance-detail__body{padding-top:144px}}