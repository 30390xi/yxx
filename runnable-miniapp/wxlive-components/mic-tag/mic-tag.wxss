.mic-tag__inner{border-radius:8px;display:inline-block;overflow:hidden}.mic-tag__voice{align-items:center;background-color:rgba(0,0,0,.5);box-sizing:border-box;display:-webkit-flex;display:flex;flex-direction:column;height:109px;justify-content:center;padding:8px;width:88px}.mic-tag__voice__icon{border-radius:50%;position:relative}.mic-tag__avatar{border-radius:inherit;height:40px;position:relative;width:40px;z-index:1}.mic-tag__voice__info{color:hsla(0,0%,100%,.9);font-size:14px;margin-top:4px;overflow:hidden;text-align:center;text-overflow:ellipsis;white-space:nowrap;width:100%}.mic-tag__video__container{border-radius:8px;height:160px;overflow:hidden;position:relative;width:120px}.mic-tag-video__cover{bottom:0;left:0;position:absolute;right:0;top:0}.mic-tag-video__cover,.mic-tag__video{height:100%;width:100%}.mic-tag__video live-player{border-radius:inherit}.mic-tag__error{align-items:center;background-color:rgba(0,0,0,.2);color:hsla(0,0%,100%,.9);display:-webkit-flex;display:flex;flex-direction:column;font-size:14px;justify-content:center;opacity:.9}.mic-tag__error__info{margin-bottom:4px}.mic-tag__error__info:last-child{margin-bottom:0}.mic-tag__video__error{height:160px;width:120px}.mic-tag__voice__error{height:109px;width:88px}