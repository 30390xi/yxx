<view class="container data-v-29009bda">
    <uni-navbar bind:__l="__l" class="data-v-29009bda" title="AI旅行搭子" type="transparentFixed" vueId="23a001c7-1"></uni-navbar>
    <view class="form-card data-v-29009bda">
        <view class="form-card-title data-v-29009bda">
            <view class="form-card-title-text data-v-29009bda">{{''+title+''}}</view>
            <view bindtap="__e" class="form-card-title-icon data-v-29009bda" data-event-opts="{{[ [ 'tap',[ [ 'openEditTitle',['$event'] ] ] ] ]}}">
                <image mode class="data-v-29009bda" src="/static/captured/c0aa6017b8f52cfb.png"></image>
            </view>
        </view>
        <view class="form-card-content data-v-29009bda">{{''+travelContent+''}}</view>
    </view>
    <view bindtap="__e" class="form-btn data-v-29009bda" data-event-opts="{{[ [ 'tap',[ ['goLoadPage'] ] ] ]}}">开启生成攻略</view>
    <uni-popup bind:__l="__l" class="data-v-29009bda vue-ref" data-ref="editTitlePopup" type="center" vueId="23a001c7-2" vueSlots="{{['default']}}">
        <view class="edit-title-popup data-v-29009bda">
            <view class="popup-title data-v-29009bda">标题编辑<image bindtap="__e" class="data-v-29009bda" data-event-opts="{{[ [ 'tap',[ [ 'closeEditTitle',['$event'] ] ] ] ]}}" src="/static/captured/bf2ca942015a5264.png"></image>
            </view>
            <input bindblur="__e" bindinput="__e" class="popup-input data-v-29009bda" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '','tempTitle','$event',[] ] ],[ 'onTitleInput',['$event'] ] ] ],[ 'blur',[ [ 'onTitleBlur',['$event'] ] ] ] ]}}" maxlength="{{15}}" placeholder="请输入标题" value="{{tempTitle}}"></input>
            <view class="char-count data-v-29009bda">{{$root.g0+'/15'}}</view>
            <view class="popup-actions data-v-29009bda">
                <view bindtap="__e" class="popup-btn confirm data-v-29009bda" data-event-opts="{{[ [ 'tap',[ [ 'confirmEditTitle',['$event'] ] ] ] ]}}">确定</view>
            </view>
        </view>
    </uni-popup>
</view>
