<view class="verify-code data-v-8a49c06c">
    <view class="cardNo data-v-8a49c06c">{{'NO. '+(info.cardNo||'')}}</view>
    <view class="swiper-code data-v-8a49c06c">
        <view class="code data-v-8a49c06c" wx:if="{{qrCode&&info.status===3}}">
            <l-painter bind:__l="__l" class="data-v-8a49c06c" vueId="22acb566-1" vueSlots="{{['default']}}">
                <l-painter-qrcode bind:__l="__l" class="data-v-8a49c06c" css="width: 380rpx; height: 380rpx" text="{{qrCode}}" vueId="{{'22acb566-2'+','+'22acb566-1'}}" wx:if="{{qrCode}}"></l-painter-qrcode>
            </l-painter>
        </view>
        <view class="code data-v-8a49c06c" wx:if="{{qrCode&&info.status!==3}}">
            <view class="lapse _div data-v-8a49c06c">
                <image class="data-v-8a49c06c" mode="scaleToFill" src="/static/captured/98ac911bdd514e86.png"></image>
                <text class="data-v-8a49c06c">该权益已失效</text>
            </view>
        </view>
    </view>
    <view class="code-tip data-v-8a49c06c">
        <u-icon bind:__l="__l" class="data-v-8a49c06c" color="#989898" name="error-circle" size="28" vueId="22acb566-3"></u-icon>
        <text class="data-v-8a49c06c">核验码定时更新，请勿截屏，以免影响正常使用</text>
    </view>
    <view class="shop data-v-8a49c06c">
        <view class="shop-header data-v-8a49c06c">
            <view class="shop-header-left data-v-8a49c06c">{{'可用商家（'+$root.f0+'家）'}}</view>
            <view bindtap="__e" class="shop-header-right data-v-8a49c06c" data-event-opts="{{[ [ 'tap',[ ['goShopList'] ] ] ]}}">查看全部<image class="data-v-8a49c06c" src="/static/captured/7abfd6192206038e.png"></image>
            </view>
        </view>
        <view bindtap="__e" class="shop-body data-v-8a49c06c" data-event-opts="{{[ [ 'tap',[ [ 'goShopList',[1] ] ] ] ]}}" wx:if="{{info.verifyNum}}">已经去过<text class="data-v-8a49c06c">{{info.verifyNum||'0'}}</text>
            <image class="data-v-8a49c06c" src="/static/captured/89c4bac08bebdaed.png"></image>
        </view>
    </view>
    <view class="owner data-v-8a49c06c" wx:if="{{hasUserInfo}}">
        <image class="data-v-8a49c06c" mode="aspectFill" src="{{info.cardholderFaceUrl?info.cardholderFaceUrl:logo}}"></image>
        <view class="owner-info data-v-8a49c06c">
            <view class="line data-v-8a49c06c" wx:if="{{getInfo.cardholderName}}">
                <view class="label data-v-8a49c06c">姓名</view>
                <view class="info data-v-8a49c06c">{{''+getInfo.cardholderName+''}}<image bindtap="__e" class="icon data-v-8a49c06c" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}" src="{{!isShowAll?'/static/captured/522f50b3281db509.png':'/static/captured/6989ca664d2f4eeb.png'}}"></image>
                </view>
            </view>
            <view class="line data-v-8a49c06c" wx:if="{{getInfo.cardholderIdCard}}">
                <view class="label data-v-8a49c06c">身份证</view>
                <view class="info data-v-8a49c06c">{{''+getInfo.cardholderIdCard+''}}<image bindtap="__e" class="icon data-v-8a49c06c" data-event-opts="{{[ [ 'tap',[ [ 'e1',['$event'] ] ] ] ]}}" src="{{!isShowAll?'/static/captured/522f50b3281db509.png':'/static/captured/6989ca664d2f4eeb.png'}}" wx:if="{{!getInfo.cardholderName}}"></image>
                </view>
            </view>
            <view class="line data-v-8a49c06c" wx:if="{{getInfo.cardholderMobile}}">
                <view class="label data-v-8a49c06c">手机号</view>
                <view class="info data-v-8a49c06c">{{''+getInfo.cardholderMobile+''}}<image bindtap="__e" class="icon data-v-8a49c06c" data-event-opts="{{[ [ 'tap',[ [ 'e2',['$event'] ] ] ] ]}}" src="{{!isShowAll?'/static/captured/522f50b3281db509.png':'/static/captured/6989ca664d2f4eeb.png'}}" wx:if="{{!getInfo.cardholderName&&!getInfo.cardholderIdCard}}"></image>
                </view>
            </view>
        </view>
    </view>
</view>
