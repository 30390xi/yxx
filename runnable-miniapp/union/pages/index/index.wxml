<view class="u-wrap page-box data-v-2e00899c">
    <uni-navbar bind:__l="__l" class="data-v-2e00899c" title="陕西联合会员权益中心" transparentFixedFontColor="{{titleColor}}" type="transparentFixed" vueId="6c75fb4c-1"></uni-navbar>
    <view bindtap="__e" class="top-box data-v-2e00899c" data-event-opts="{{[ [ 'tap',[ ['isUnion'] ] ] ]}}">
        <image class="bg-img data-v-2e00899c" mode="aspectFill" src="https://eshopfile.zhiyousx.com/2024062010391767799.png"></image>
        <view class="tip-box data-v-2e00899c">
            <image mode class="logo data-v-2e00899c" src="{{unionUserInfo.photoUrl?unionUserInfo.photoUrl:logo}}"></image>
            <view class="user-box data-v-2e00899c" wx:if="{{isUnionMember}}">
                <view class="name data-v-2e00899c">{{''+(unionUserInfo.nickName||'')+''}}</view>
                <view class="time-info allcenter data-v-2e00899c">{{''+$root.f0+'日到期'}}<view catchtap="__e" class="btn allcenter data-v-2e00899c" data-event-opts="{{[ [ 'tap',[ [ 'jumpToMin',['$event'] ] ] ] ]}}">去续费<u-icon bind:__l="__l" class="data-v-2e00899c" color="#FFFFFF" name="arrow-right" size="24" style="margin-left:8rpx;" vueId="6c75fb4c-2"></u-icon>
                    </view>
                </view>
            </view>
            <block wx:else>
                <text class="data-v-2e00899c">+前往</text>
                <text class="imp data-v-2e00899c">陕西联合会员中心</text>
                <text class="data-v-2e00899c">购卡</text>
            </block>
        </view>
        <view catchtap="__e" class="code-box allcenter data-v-2e00899c" data-event-opts="{{[ [ 'tap',[ [ 'toUserCard',['$event'] ] ] ] ]}}" wx:if="{{!unionExpired&&isUnionMember}}">
            <image mode class="code data-v-2e00899c" src="https://eshopfile.zhiyousx.com/2024062114233519836.png"></image>会员码</view>
    </view>
    <view class="module-box data-v-2e00899c">
        <view class="black-box data-v-2e00899c" wx:if="{{$root.g0}}">
            <view class="flex col-center row-space-between data-v-2e00899c">
                <view class="title flex col-center data-v-2e00899c">
                    <image mode class="t-img data-v-2e00899c" src="https://eshopfile.zhiyousx.com/2024052310373321295.png"></image>
                    <text class="data-v-2e00899c">吃喝玩乐</text>
                    <text class="union-color data-v-2e00899c">热门权益</text>
                </view>
                <view bindtap="__e" class="toR flex col-center data-v-2e00899c" data-event-opts="{{[ [ 'tap',[ [ 'jumpTo',['/union/pages/list/list'] ] ] ] ]}}">
                    <text class="data-v-2e00899c">{{$root.f1+'特权'}}</text>
                    <image mode class="r-img data-v-2e00899c" src="https://eshopfile.zhiyousx.com/2024052310422161768.png"></image>
                </view>
            </view>
            <view class="row-box data-v-2e00899c">
                <view bindtap="__e" class="item data-v-2e00899c" data-event-opts="{{[ [ 'tap',[ [ 'jumpToS',['/pages/spotDetailNew/spotDetailNew?spotId='+it.scenicId+'&isUnion=1'] ] ] ] ]}}" wx:if="{{i<8}}" wx:for="{{cardList}}" wx:for-index="i" wx:for-item="it" wx:key="i">
                    <image class="item-img data-v-2e00899c" mode="aspectFill" src="{{it.scenicImage}}"></image>
                    <view class="name singleLineText data-v-2e00899c">{{''+it.scenicName+''}}</view>
                    <view class="tip singleLineText data-v-2e00899c">{{''+it.equityDesc+''}}</view>
                </view>
            </view>
        </view>
        <view class="black-box data-v-2e00899c" wx:if="{{$root.g1}}">
            <view class="flex col-center row-space-between data-v-2e00899c">
                <view class="title flex col-center data-v-2e00899c">
                    <image mode class="t-img data-v-2e00899c" src="https://eshopfile.zhiyousx.com/2024052310373321295.png"></image>
                    <text class="data-v-2e00899c">旅游出行</text>
                    <text class="union-color data-v-2e00899c">{{'畅玩'+month+'月'}}</text>
                </view>
                <view bindtap="__e" class="toR flex col-center data-v-2e00899c" data-event-opts="{{[ [ 'tap',[ [ 'jumpTo',['/union/pages/coupon/coupon'] ] ] ] ]}}">
                    <text class="data-v-2e00899c">{{$root.f2+'神券'}}</text>
                    <image mode class="r-img data-v-2e00899c" src="https://eshopfile.zhiyousx.com/2024052310422161768.png"></image>
                </view>
            </view>
            <scroll-view class="col-box data-v-2e00899c" scrollWithAnimation="{{true}}" scrollX="{{true}}">
                <view class="col-item data-v-2e00899c" wx:if="{{i<6}}" wx:for="{{$root.l0}}" wx:for-index="i" wx:for-item="it" wx:key="i">
                    <view class="i-t data-v-2e00899c">
                        <view class="item-img-b data-v-2e00899c">
                            <image class="img data-v-2e00899c" mode="aspectFill" src="{{it.$orig.showImage}}"></image>
                            <view class="sign data-v-2e00899c">{{''+(it.$orig.itemType==1?'门票':'线路')+''}}</view>
                        </view>
                        <view class="item-info data-v-2e00899c">
                            <view class="price-box data-v-2e00899c" wx:if="{{it.$orig.type==3}}">
                                <text class="data-v-2e00899c">免单</text>
                            </view>
                            <view class="price-box data-v-2e00899c" wx:else>
                                <text class="ps data-v-2e00899c">￥</text>
                                <text class="data-v-2e00899c">{{it.$orig.quota}}</text>
                            </view>
                            <view class="info-t singleLineText data-v-2e00899c">{{''+it.f3+''}}</view>
                            <view bindtap="__e" class="{{['btn','data-v-2e00899c',it.$orig.receiveButton==2||it.$orig.receiveButton==4||it.$orig.receiveButton==5?'dis':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'receiveCoupon',['$0'],[ [ ['couponList','',i] ] ] ] ] ] ]}}">{{''+it.f4+''}}</view>
                        </view>
                    </view>
                    <view class="i-b singleLineText data-v-2e00899c">{{''+it.$orig.showName+''}}</view>
                </view>
            </scroll-view>
        </view>
        <view class="black-box data-v-2e00899c" wx:if="{{cardInfo.serviceExpertAddress&&cardInfo.serviceExpertPhone&&cardInfo.cooperationAddress}}">
            <view class="flex col-center row-space-between data-v-2e00899c">
                <view class="title flex col-center data-v-2e00899c">
                    <image mode class="t-img data-v-2e00899c" src="https://eshopfile.zhiyousx.com/2024052310373321295.png"></image>
                    <text class="data-v-2e00899c">帮助中心</text>
                </view>
                <view class="toR flex col-center data-v-2e00899c"></view>
            </view>
            <view class="help-row flex col-center row-space-between data-v-2e00899c" wx:if="{{cardInfo.serviceExpertAddress&&cardInfo.serviceExpertPhone}}">
                <view class="r-left flex col-center data-v-2e00899c">
                    <image mode class="icon-l data-v-2e00899c" src="https://eshopfile.zhiyousx.com/2024052311363025995.png"></image>
                    <view class="l-info data-v-2e00899c">
                        <view class="name data-v-2e00899c">服务专家</view>
                        <view class="time singleLineText data-v-2e00899c" hidden="{{!cardInfo.serviceExpertDesc}}">{{''+cardInfo.serviceExpertDesc+''}}</view>
                    </view>
                </view>
                <view class="r-right data-v-2e00899c">
                    <image mode bindtap="__e" class="icon data-v-2e00899c" data-event-opts="{{[ [ 'tap',[ [ 'jumpToH5',['$0'],['cardInfo.serviceExpertAddress'] ] ] ] ]}}" src="https://eshopfile.zhiyousx.com/2024052311431440330.png" wx:if="{{cardInfo.serviceExpertAddress}}"></image>
                    <image mode bindtap="__e" class="icon data-v-2e00899c" data-event-opts="{{[ [ 'tap',[ [ 'phone',['$event'] ] ] ] ]}}" src="https://eshopfile.zhiyousx.com/2024052311431841365.png" wx:if="{{cardInfo.serviceExpertPhone}}"></image>
                </view>
            </view>
            <block wx:if="{{cardInfo.cooperationAddress}}">
                <view class="line data-v-2e00899c"></view>
                <view bindtap="__e" class="help-row flex col-center row-space-between data-v-2e00899c" data-event-opts="{{[ [ 'tap',[ [ 'jumpToH5',['$0'],['cardInfo.cooperationAddress'] ] ] ] ]}}">
                    <view class="r-left flex col-center data-v-2e00899c">
                        <image mode class="icon-l data-v-2e00899c" src="https://eshopfile.zhiyousx.com/2024052311452667077.png"></image>
                        <text class="data-v-2e00899c">企业合作</text>
                    </view>
                    <view class="r-right data-v-2e00899c">
                        <image mode class="data-v-2e00899c" src="https://eshopfile.zhiyousx.com/2024052310422161768.png"></image>
                    </view>
                </view>
            </block>
        </view>
    </view>
</view>
