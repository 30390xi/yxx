<view class="chat-item">
    <view class="{{[true?'chat-container':'',item.type==1?'chat-location-me':'']}}">
        <view class="chat-content-container">
            <view class="chat-text-container-super" style="{{'justify-content:'+(item.type==1?'flex-end':'flex-start')+';'}}" wx:if="{{!item.historyLine&&!item.nomoreLine}}">
                <view class="{{[true?'chat-text-container':'',item.type==1?'chat-text-container-me':'',item.type!=1?'chat-text-container-no':'']}}">
                    <view class="bubble">
                        <view class="{{[true?'chat-text':'']}}">
                            <view space="nbsp" userSelect="true" wx:if="{{item.content&&item.type!=1}}">
                                <zero-markdown-view bind:__l="__l" markdown="{{item.content}}" vueId="fe1fd6e6-1"></zero-markdown-view>
                            </view>
                            <view class="chat-text-me" wx:if="{{item.content&&item.type==1}}">{{''+item.content+''}}</view>
                            <view class="loading-box" wx:if="{{!item.content}}">{{''+(lang==='zh'?'正在思考中':'Thinking')+''}}<view class="loading">
                                    <view class="pot"></view>
                                    <view class="pot"></view>
                                    <view class="pot"></view>
                                </view>
                            </view>
                            <view style="width:100%;margin-top:30rpx;" wx:if="{{item.picture}}">
                                <view class="pictureCard">
                                    <image bindtap="__e" class="pictureImage" data-event-opts="{{[ [ 'tap',[ [ 'previewImage',['$0'],['item.picture'] ] ] ] ]}}" lazyLoad="false" mode="widthFix" src="{{item.picture}}"></image>
                                </view>
                            </view>
                            <view style="width:100%;margin-top:30rpx;" wx:if="{{$root.g0}}">
                                <scroll-view class="card-item" scrollX="true">
                                    <view class="card-item-count">
                                        <view bindtap="__e" class="card-item-box" data-event-opts="{{[ [ 'tap',[ [ 'scenicDetails',['$0'],[ [ ['item.list','id',el.$orig.id] ] ] ] ] ] ]}}" style="{{'margin-right:'+(i<el.g1-1?'20rpx':'0')+';'}}" wx:for="{{$root.l1}}" wx:for-index="i" wx:for-item="el" wx:key="id">
                                            <view class="card-type">景区</view>
                                            <image class="card-image" lazyLoad="false" mode="aspectFill" src="{{el.$orig.mainPic||'/static/captured/200e3d1b915af6be.png'}}"></image>
                                            <view class="card-name">{{''+el.$orig.name+''}}</view>
                                            <view class="tag-item-box parent" wx:if="{{el.g2}}">
                                                <view class="tag-item child" wx:if="{{index<3}}" wx:for="{{el.l0}}" wx:for-item="ele" wx:key="index">{{ele+''}}</view>
                                            </view>
                                        </view>
                                    </view>
                                </scroll-view>
                            </view>
                            <view class="spotMsg" wx:if="{{item.spotMsg}}">{{item.spotMsg}}</view>
                            <scroll-view class="list-scroll" scrollX="true" style="width:100%;margin-top:30rpx;" wx:if="{{$root.g3}}">
                                <view class="scrollItem" wx:for="{{item.spotList}}" wx:for-index="i" wx:for-item="el" wx:key="i">
                                    <view class="spotCard">
                                        <image class="spotImg" lazyLoad="false" mode="aspectFill" src="{{el.picUrl||'/static/captured/200e3d1b915af6be.png'}}"></image>
                                        <view class="spotInfo">
                                            <view class="spotName singleLineText">{{''+(lang=='zh'?el.chinese.name:el.english.name)+''}}</view>
                                            <view class="spotDescription">{{''+(lang=='zh'?el.chinese.introductionText:el.english.introductionText)+''}}</view>
                                            <view class="bottom">
                                                <view class="distance">
                                                    <image src="/static/captured/5fa6cec6cd17b2ed.png"></image>{{''+el.distance+'m'}}</view>
                                                <view bindtap="__e" class="jumpBtn" data-event-opts="{{[ [ 'tap',[ [ 'gotoMap',['$0'],[ [ ['item.spotList','',i] ] ] ] ] ] ]}}">{{''+(lang=='zh'?'去这里':'Jump Here')+''}}</view>
                                            </view>
                                        </view>
                                    </view>
                                </view>
                            </scroll-view>
                            <view class="tabs" wx:if="{{haveTabs}}">
                                <view bindtap="__e" class="{{['tab-item',i==currentTab?'active':'',lang=='en'?'en':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'changeTab',[i] ] ] ] ]}}" wx:for="{{tabs}}" wx:for-index="i" wx:for-item="el" wx:key="i">{{''+(lang=='zh'?el.zh:el.en)+''}}</view>
                            </view>
                            <scroll-view class="list-scroll" scrollX="true" style="width:100%;margin-top:30rpx;" wx:if="{{$root.g4}}">
                                <view class="scrollItem" wx:for="{{item.scenicList}}" wx:for-index="i" wx:for-item="el" wx:key="i">
                                    <view class="spotCard">
                                        <image class="spotImg" lazyLoad="false" mode="aspectFill" src="{{el.picUrl||'/static/captured/200e3d1b915af6be.png'}}"></image>
                                        <view class="spotInfo">
                                            <view class="spotName singleLineText">{{''+(lang=='zh'?el.chinese.name:el.english.name)+''}}</view>
                                            <view class="spotDescription">{{''+(lang=='zh'?el.chinese.introductionText:el.english.introductionText)+''}}</view>
                                            <view class="bottom">
                                                <view class="distance">
                                                    <image src="/static/captured/5fa6cec6cd17b2ed.png"></image>{{''+el.distance+'m'}}</view>
                                                <view bindtap="__e" class="jumpBtn" data-event-opts="{{[ [ 'tap',[ [ 'gotoMap',['$0'],[ [ ['item.scenicList','',i] ] ] ] ] ] ]}}">{{''+(lang=='zh'?'去这里':'Jump Here')+''}}</view>
                                            </view>
                                        </view>
                                    </view>
                                </view>
                            </scroll-view>
                            <scroll-view class="list-scroll" scrollX="true" style="width:100%;margin-top:30rpx;" wx:if="{{$root.g5}}">
                                <view class="scrollItem" wx:for="{{item.foodList}}" wx:for-index="i" wx:for-item="el" wx:key="i">
                                    <view class="spotCard">
                                        <image class="spotImg" lazyLoad="false" mode="aspectFill" src="{{el.picUrl||'/static/captured/200e3d1b915af6be.png'}}"></image>
                                        <view class="spotInfo">
                                            <view class="spotName singleLineText">{{''+(lang=='zh'?el.chinese.name:el.english.name)+''}}</view>
                                            <view class="spotDescription">{{''+(lang=='zh'?el.chinese.introductionText:el.english.introductionText)+''}}</view>
                                            <view class="bottom">
                                                <view class="distance">
                                                    <image src="/static/captured/5fa6cec6cd17b2ed.png"></image>{{''+el.distance+'m'}}</view>
                                                <view bindtap="__e" class="jumpBtn" data-event-opts="{{[ [ 'tap',[ [ 'gotoMap',['$0'],[ [ ['item.foodList','',i] ] ] ] ] ] ]}}">{{''+(lang=='zh'?'去这里':'Jump Here')+''}}</view>
                                            </view>
                                        </view>
                                    </view>
                                </view>
                            </scroll-view>
                            <scroll-view class="list-scroll" scrollX="true" style="width:100%;margin-top:30rpx;" wx:if="{{$root.g6}}">
                                <view class="scrollItem" wx:for="{{item.storeList}}" wx:for-index="i" wx:for-item="el" wx:key="i">
                                    <view class="spotCard">
                                        <image class="spotImg" lazyLoad="false" mode="aspectFill" src="{{el.picUrl||'/static/captured/200e3d1b915af6be.png'}}"></image>
                                        <view class="spotInfo">
                                            <view class="spotName singleLineText">{{''+(lang=='zh'?el.chinese.name:el.english.name)+''}}</view>
                                            <view class="spotDescription">{{''+(lang=='zh'?el.chinese.introductionText:el.english.introductionText)+''}}</view>
                                            <view class="bottom">
                                                <view class="distance">
                                                    <image src="/static/captured/5fa6cec6cd17b2ed.png"></image>{{''+el.distance+'m'}}</view>
                                                <view bindtap="__e" class="jumpBtn" data-event-opts="{{[ [ 'tap',[ [ 'gotoMap',['$0'],[ [ ['item.storeList','',i] ] ] ] ] ] ]}}">{{''+(lang=='zh'?'去这里':'Jump Here')+''}}</view>
                                            </view>
                                        </view>
                                    </view>
                                </view>
                            </scroll-view>
                            <view style="width:100%;" wx:if="{{item.phone}}">
                                <view class="phoneCard">
                                    <view class="phoneInfo">
                                        <view class="list-title">{{lang=='zh'?'联系电话':'Contact Phone'}}</view>
                                        <view class="phoneNumber">{{item.phone}}</view>
                                    </view>
                                    <view bindtap="__e" class="callBtn" data-event-opts="{{[ [ 'tap',[ [ 'makePhoneCall',['$0'],['item.phone'] ] ] ] ]}}"></view>
                                </view>
                            </view>
                            <view class="warning-chat" wx:if="{{item.warningData}}">
                                <view class="warning-title">{{lang=='zh'?'为您展示':'Show Warning'}}</view>
                                <view class="warning-content">{{''+(lang=='zh'?'根据两个小时内的各个登城口的客流数据，建议您从'+item.warningData.entrance+'登城人流较少！':'Based on the passenger flow data within two hours, we recommend that you go to '+item.warningData.entrance+' for a more comfortable experience.')+''}}<view class="warning-card" wx:for="{{$root.l2}}" wx:for-index="i" wx:for-item="el" wx:key="i">
                                        <view class="warning-card-title">{{''+el.$orig.inDoor+''}}</view>
                                        <view class="warning-card-status">
                                            <image src="/static/captured/e62b3dacdbe516f6.png" style="width:26rpx;height:26rpx;margin-right:4rpx;"></image>{{''+(lang=='zh'?'客流状态：':'Flow Statu：')+''}}<image src="/static/captured/7a7aec6a291decca.png" wx:if="{{el.$orig.status=='舒适'}}"></image>
                                            <block wx:else>
                                                <image src="/static/captured/dcc4c04ddd55b6aa.png" wx:if="{{el.$orig.status=='拥挤'}}"></image>
                                                <image src="/static/captured/8f4300fb9c563bd0.png" wx:else></image>
                                            </block>
                                            <text class="{{[el.$orig.status=='舒适'?'green':'',el.$orig.status=='拥挤'?'yellow':'',el.$orig.status=='爆满'?'red':'']}}">{{el.m0}}</text>
                                            <view bindtap="__e" class="jumpBtn" data-event-opts="{{[ [ 'tap',[ [ 'gotoMap',['$0'],[ [ ['item.warningData.pointDataVOList','',i] ] ] ] ] ] ]}}">{{''+(lang=='zh'?'去这里':'Jump')+''}}</view>
                                        </view>
                                    </view>
                                </view>
                            </view>
                            <block wx:if="{{item.posture}}">
                                <view class="posture-txt">{{lang=='zh'?'为您推荐拍照出片指南，简单几步拍得更好看。':'Recommend photo pose guide to make your photo look better.'}}</view>
                                <view bindtap="__e" class="posture-btn" data-event-opts="{{[ [ 'tap',[ [ 'goPhotoPose',['$event'] ] ] ] ]}}">
                                    <image src="/static/captured/d60209c844a4f352.png"></image>{{''+(lang=='zh'?'拍照姿势':'Photo Pose')+''}}</view>
                            </block>
                        </view>
                    </view>
                </view>
            </view>
            <view class="evaluationQuestion" wx:if="{{item.type==0}}">
                <view bindtap="__e" class="evaluationItem" data-event-opts="{{[ [ 'tap',[ [ 'askAgain',['$0'],[ [ ['item.evaluationQuestion','',ind] ] ] ] ] ] ]}}" wx:for="{{item.evaluationQuestion}}" wx:for-index="ind" wx:for-item="el" wx:key="ind">{{''+el+''}}</view>
            </view>
            <view class="history-line" wx:if="{{item.historyLine||item.nomoreLine}}">{{''+(item.nomoreLine?'没有更多数据了':'以上为历史记录')+''}}</view>
        </view>
    </view>
</view>
