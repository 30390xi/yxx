<view class="chat-input-bar-container data-v-58c37474" style="{{'padding-bottom:'+(isIos?'':'30rpx')+';'}}">
    <view class="chat-input-bar data-v-58c37474">
        <view class="Hold_Talk data-v-58c37474" wx:if="{{showSpeakBtn==2}}">
            <image bindtap="__e" class="icon_keyboard data-v-58c37474" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}" lazyLoad="false" mode="aspectFill" src="/static/captured/943f97694c3a4eb0.png"></image>
            <view bindtouchend="__e" bindtouchstart="__e" class="speakBtn data-v-58c37474" data-event-opts="{{[ [ 'touchstart',[ [ 'keystart',['$event'] ] ] ],[ 'touchend',[ [ 'stopVoice',['$event'] ] ] ] ]}}">{{$root.m0}}</view>
        </view>
        <view class="Hold_Talk_f data-v-58c37474" wx:if="{{showSpeakBtn==3}}">
            <image class="icon_keyboard data-v-58c37474" lazyLoad="false" mode="aspectFill" src="/static/captured/64e33b31f8c84876.png"></image>
        </view>
        <image bindtap="__e" class="icon data-v-58c37474" data-event-opts="{{[ [ 'tap',[ [ 'getSpeak',['$event'] ] ] ] ]}}" mode="aspectFill" src="/static/captured/eb5877f7d1465b6f.png" wx:if="{{showSpeakBtn==1}}"></image>
        <view class="chat-input-container data-v-58c37474" wx:if="{{showSpeakBtn==1}}">
            <input adjustPosition="{{false}}" bindconfirm="__e" bindinput="__e" class="chat-input data-v-58c37474" confirmType="send" cursorSpacing="{{50}}" data-event-opts="{{[ [ 'confirm',[ [ 'sendClick',['$event'] ] ] ],[ 'input',[ [ '__set_model',[ '','msg','$event',[] ] ] ] ] ]}}" focus="{{focus}}" placeholder="{{$root.m1}}" type="text" value="{{msg}}"></input>
        </view>
        <view class="right-btn data-v-58c37474">
            <image bindtap="__e" class="chat-input-send1 data-v-58c37474" data-event-opts="{{[ [ 'tap',[ [ 'sendClick',['$event'] ] ] ] ]}}" lazyLoad="false" mode="aspectFill" src="/static/captured/b65e964b1fc5fab5.png" wx:if="{{showSpeakBtn==1&&pushingProgress}}"></image>
        </view>
    </view>
    <view class="prompt data-v-58c37474">{{''+$root.m2+''}}</view>
    <view class="layer-box data-v-58c37474">
        <view class="prompt-layer data-v-58c37474" wx:if="{{longPress}}">
            <view class="prompt-loader data-v-58c37474">
                <view class="em data-v-58c37474" wx:for="{{15}}" wx:for-index="__i0__" wx:key="*this"></view>
            </view>
            <text class="p data-v-58c37474">{{value}}</text>
            <text class="span data-v-58c37474">{{$root.m3}}</text>
        </view>
    </view>
    <view bindtap="__e" class="stopBtn data-v-58c37474" data-event-opts="{{[ [ 'tap',[ [ 'stopSpeak',['$event'] ] ] ] ]}}" wx:if="{{!pushingProgressShow}}">
        <image class="icon data-v-58c37474" lazyLoad="false" mode="aspectFill" src="/static/captured/3813262be30d34c4.png"></image>{{''+$root.m4+''}}</view>
</view>
