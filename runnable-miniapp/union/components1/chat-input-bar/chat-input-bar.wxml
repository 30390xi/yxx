<view class="chat-input-bar-container data-v-37d135a8" style="{{'padding-bottom:'+(isIos?'':'30rpx')+';'}}">
    <view class="chat-select-ask data-v-37d135a8">
        <scroll-view class="chat-select-scroll data-v-37d135a8" scrollX="{{true}}" scrollY="{{false}}">
            <view bindtap="__e" class="{{['chat-select-item','data-v-37d135a8',!pushingProgressShow?'forbidden':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'resetTravel',['$event'] ] ] ] ]}}">AI旅行规划</view>
            <view bindtap="__e" class="{{['chat-select-item','data-v-37d135a8',!pushingProgressShow?'forbidden':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'goHistory',['$event'] ] ] ] ]}}" wx:if="{{hasHistory}}">查看历史记录</view>
            <view bindtap="__e" class="{{['chat-select-item1','data-v-37d135a8',!pushingProgressShow?'forbidden':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'askClick',['$0'],[ [ ['defaultList','id',it.id,'content'] ] ] ] ] ] ]}}" style="{{'background:'+(showHide?'rgba(255, 255, 255, .5)':'rgba(208, 161, 108, 0.2)')+';'}}" wx:for="{{defaultList}}" wx:for-item="it" wx:key="id">{{''+it.content+''}}</view>
        </scroll-view>
    </view>
    <view class="chat-input-bar data-v-37d135a8">
        <view class="Hold_Talk data-v-37d135a8" wx:if="{{showSpeakBtn==2}}">
            <image bindtap="__e" class="icon_keyboard data-v-37d135a8" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}" lazyLoad="false" mode="aspectFill" src="/static/captured/8aeaee997cd728d9.png"></image>
            <view bindtouchend="__e" bindtouchstart="__e" class="speakBtn data-v-37d135a8" data-event-opts="{{[ [ 'touchstart',[ [ 'keystart',['$event'] ] ] ],[ 'touchend',[ [ 'stopVoice',['$event'] ] ] ] ]}}">按住说话</view>
        </view>
        <view class="Hold_Talk_f data-v-37d135a8" wx:if="{{showSpeakBtn==3}}">
            <image class="icon_keyboard data-v-37d135a8" lazyLoad="false" mode="aspectFill" src="/static/captured/924c724b8c7d0757.png"></image>
        </view>
        <view class="chat-input-container data-v-37d135a8" wx:if="{{showSpeakBtn==1}}">
            <image bindtap="__e" class="icon data-v-37d135a8" data-event-opts="{{[ [ 'tap',[ [ 'getSpeak',['$event'] ] ] ] ]}}" mode="aspectFill" src="/static/captured/16223d1a812d256d.png"></image>
            <input adjustPosition="{{false}}" bindconfirm="__e" bindinput="__e" class="chat-input data-v-37d135a8" confirmType="send" cursorSpacing="{{50}}" data-event-opts="{{[ [ 'confirm',[ [ 'sendClick',['$event'] ] ] ],[ 'input',[ [ '__set_model',[ '','msg','$event',[] ] ] ] ] ]}}" focus="{{focus}}" placeholder="请输入您的问题" type="text" value="{{msg}}"></input>
        </view>
        <view class="right-btn data-v-37d135a8">
            <image bindtap="__e" class="chat-input-send1 data-v-37d135a8" data-event-opts="{{[ [ 'tap',[ [ 'sendClick',['$event'] ] ] ] ]}}" lazyLoad="false" mode="aspectFill" src="/static/captured/b5551ec684931d33.png" wx:if="{{showSpeakBtn==1&&pushingProgress}}"></image>
            <image bindtap="__e" class="chat-input-send data-v-37d135a8" data-event-opts="{{[ [ 'tap',[ [ 'setcolse',['$event'] ] ] ] ]}}" lazyLoad="false" mode="aspectFill" src="/static/captured/abeb3ca173c1cc11.png" wx:if="{{!showHide&&(showSpeakBtn==1||showSpeakBtn==2||showSpeakBtn==3)&&delayBtn}}"></image>
        </view>
    </view>
    <view class="prompt data-v-37d135a8">内容由AI生成，无法确保真实准确，仅供参考</view>
    <view class="layer-box data-v-37d135a8">
        <view class="prompt-layer data-v-37d135a8" wx:if="{{longPress}}">
            <view class="prompt-loader data-v-37d135a8">
                <view class="em data-v-37d135a8" wx:for="{{15}}" wx:for-index="__i0__" wx:key="*this"></view>
            </view>
            <text class="p data-v-37d135a8">{{value}}</text>
            <text class="span data-v-37d135a8">松手结束录音</text>
        </view>
    </view>
    <view bindtap="__e" class="stopBtn data-v-37d135a8" data-event-opts="{{[ [ 'tap',[ [ 'stopSpeak',['$event'] ] ] ] ]}}" wx:if="{{!pushingProgressShow}}">
        <image class="icon data-v-37d135a8" lazyLoad="false" mode="aspectFill" src="/static/captured/3813262be30d34c4.png"></image>停止回答</view>
</view>
